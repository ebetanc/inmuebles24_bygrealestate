# Meta Cloud API webhook and outbound delivery
WA_CLOUD_API_BASE_URL=https://graph.facebook.com
WA_API_VERSION=vXX.X
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_SECRET=
WF1_WORKFLOW_ID=
WF13_WORKFLOW_ID=

# n8n Code nodes use Node's crypto module for raw-body HMAC verification.
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_DEFAULT_BINARY_DATA_MODE=memory
