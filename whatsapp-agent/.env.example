# ============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
# ============================================================================

# --- Supabase Postgres ------------------------------------------------------
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string
# Choose "URI" format. Use the "Session pooler" (port 5432) connection string,
# NOT the "Transaction pooler" (6543) — n8n sometimes needs prepared statements
# that the transaction pooler doesn't support.
#
# If you're running n8n on the same machine you're developing on, you can use
# the direct connection. For production n8n on a server, use session pooler.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Twilio -----------------------------------------------------------------
# Get these from: Twilio Console → Account Dashboard (top right)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Your WhatsApp sender (sandbox or production). MUST include 'whatsapp:' prefix.
# Sandbox default: whatsapp:+14155238886
# Production: whatsapp:+<your approved number>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Manager number for auction-expiry escalations. MUST include 'whatsapp:' prefix.
MANAGER_WHATSAPP_TO=whatsapp:+5215500000099

# --- EasyBroker -------------------------------------------------------------
# Get this from: EasyBroker Dashboard → Settings → API → API Key
EASYBROKER_API_KEY=your_easybroker_api_key

# --- LLM (for WF4, not used in WF3) -----------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- n8n (optional, only if running n8n via docker-compose in this repo) ----
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_PROTOCOL=http
# WEBHOOK_URL=https://your-tunnel-or-domain.com/
