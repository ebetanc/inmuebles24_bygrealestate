# ============================================================================
# WhatsApp Agent - Environment Variables
# Copy to .env and fill in real values. .env is gitignored.
# ============================================================================

# --- Supabase Postgres -----------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string (URI format)
# Use "Session pooler" (port 5432), NOT "Transaction pooler" (6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Evolution API ----------------------------------------------------------
# Your Evolution API instance URL (no trailing slash)
EVOLUTION_API_URL=https://evolution.yourdomain.com
# Instance name (created in Evolution dashboard)
EVOLUTION_INSTANCE=inmobiliaria24
# API key (from Evolution global settings or instance settings)
EVOLUTION_API_KEY=your_evolution_api_key

# --- Manager escalation ----------------------------------------------------
# Manager phone for auction-expiry escalations. Plain digits, no + prefix.
MANAGER_PHONE=5215500000099

# --- EasyBroker -------------------------------------------------------------
EASYBROKER_API_KEY=your_easybroker_api_key

# --- OpenRouter (for WF4 AI conversation) -----------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key
# Model to use (can change anytime). Examples:
#   anthropic/claude-sonnet-4   google/gemini-2.5-flash
#   openai/gpt-4o               meta-llama/llama-4-maverick
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# --- n8n Workflow IDs (set after importing all workflows) -------------------
# Import all WF JSONs, then note their IDs from the n8n URL bar and set here.
WF2_WORKFLOW_ID=
WF3A_WORKFLOW_ID=
WF3B_WORKFLOW_ID=
WF4_WORKFLOW_ID=
WF5_WORKFLOW_ID=
WF6_WORKFLOW_ID=
WF8_WORKFLOW_ID=
WF10_WORKFLOW_ID=

# --- Google Sheets (for WF6 guard schedule) --------------------------------
# Full URL of the Google Sheet with guard schedule
GUARD_SCHEDULE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
# Sheet tab name (default: Guardias)
GUARD_SCHEDULE_SHEET_NAME=Guardias
