{
  "name": "WF1 - Inbound Router (Evolution)",
  "nodes": [
    {
      "parameters": {"inputSource": "passthrough"},
      "id": "2dd402fb-2665-45d6-82c4-7d7cdb08242a",
      "name": "When Called by WF22",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "notes": "Receives only authenticated Meta message payloads from WF22."
    },
    {
      "parameters": {
        "jsCode": "// Parse authenticated Meta Cloud API inbound message.\nconst body=$input.first().json.body||{}; const value=body.entry?.[0]?.changes?.[0]?.value||{}; const msg=value.messages?.[0];\nif(!msg) return [{json:{_action:'ignore',reason:'no_message'}}];\nlet text=msg.text?.body||msg.button?.text||''; let interactive_id='';\nif(msg.interactive?.button_reply){text=msg.interactive.button_reply.title||'';interactive_id=msg.interactive.button_reply.id||'';}\nelse if(msg.interactive?.list_reply){text=msg.interactive.list_reply.title||'';interactive_id=msg.interactive.list_reply.id||'';}\nif(!text&&!interactive_id) return [{json:{_action:'ignore',reason:'unsupported_message_type'}}];\nconst phone=String(msg.from||''); const contact=value.contacts?.[0]||{};\nreturn [{json:{_action:'process',phone,text:String(text).trim(),interactive_id,pushName:contact.profile?.name||'',messageId:String(msg.id||''),timestamp:Number(msg.timestamp)||Math.floor(Date.now()/1000),remoteJid:phone}}];"
      },
      "id": "cea82b5d-4fde-4e15-a0a0-5f279866802b",
      "name": "Parse Evolution Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "4b4a6519-0649-4254-8d9e-d0fa81afa6b5",
              "leftValue": "={{ $json._action }}",
              "rightValue": "process",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "80631397-0ac5-4044-b540-7f30602bb797",
      "name": "Valid Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Dedup + Classify + Link + Night activation in one round-trip.\n-- C3 fix: classify FIRST, then insert message with correct conversation_id.\n-- C4 fix: auto-activate night_queued conversations for AI handling.\nWITH classification AS (\n  SELECT * FROM classify_sender($4)\n),\nactivate_night AS (\n  UPDATE conversations\n  SET mode = 'ai'\n  WHERE conversation_id = (SELECT conversation_id FROM classification)\n    AND mode = 'night_queued'\n),\ndedup AS (\n  INSERT INTO messages (conversation_id, direction, sender_type, body, msg_external_id, metadata)\n  VALUES ((SELECT conversation_id FROM classification), 'inbound', 'lead', $1, $2, $3::jsonb)\n  ON CONFLICT (msg_external_id) DO NOTHING\n  RETURNING message_id\n)\nSELECT\n  (SELECT message_id FROM dedup) AS new_message_id,\n  c.is_agent,\n  c.agent_id,\n  c.agent_name,\n  c.conversation_id,\n  CASE WHEN c.conv_mode = 'night_queued' THEN 'ai' ELSE c.conv_mode END AS conv_mode,\n  c.assigned_agent_id,\n  c.current_property,\n  c.assigned_agent_phone\nFROM classification c;",
        "options": {
          "queryReplacement": "={{ [$json.text, $json.messageId, JSON.stringify({ phone: $json.phone, pushName: $json.pushName, timestamp: $json.timestamp }), $json.phone] }}"
        }
      },
      "id": "fe60518a-2419-4e35-9133-283023544ab3",
      "name": "Dedup + Classify Sender",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        860,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Route deduplicated inbound messages and bind claims to opportunity+tier.\nconst parsed = $('Parse Evolution Payload').first().json;\nconst db = $input.first().json;\nif (!db.new_message_id && db.new_message_id !== 0) return [{ json: { route: 'ignore', reason: 'duplicate_message' } }];\nconst { phone, text, pushName, messageId } = parsed;\nif (db.is_agent) {\n  const claim = String(parsed.interactive_id || '').match(/^claim:(\\d+):(owner|primary_guard|backup_guard)$/);\n  if (claim) return [{ json: { route: 'agent_claim', agent_id: db.agent_id, agent_name: db.agent_name, agent_phone: phone, opportunity_id: Number(claim[1]), routing_tier: claim[2], button_id: parsed.interactive_id, raw_message: text, messageId } }];\n  const legacy = text.match(/^TOMO-([A-Z0-9]{4})$/i);\n  if (legacy) return [{ json: { route: 'agent_claim', agent_id: db.agent_id, agent_name: db.agent_name, agent_phone: phone, short_code: legacy[1].toUpperCase(), raw_message: text, messageId } }];\n  return [{ json: { route: 'agent_followup_reply', agent_id: db.agent_id, agent_name: db.agent_name, agent_phone: phone, text, messageId } }];\n}\nif (!db.conversation_id) return [{ json: { route: 'new_lead', phone, pushName, text, messageId } }];\nconst common = { conversation_id: db.conversation_id, phone, pushName, text, messageId };\nif (db.conv_mode === 'ai') return [{ json: { route: 'ai_conversation', ...common, current_property: db.current_property, assigned_agent_id: db.assigned_agent_id } }];\nif (db.conv_mode === 'human') return [{ json: { route: 'human_forward', ...common, assigned_agent_id: db.assigned_agent_id, assigned_agent_phone: db.assigned_agent_phone } }];\nif (db.conv_mode === 'pending_assignment') return [{ json: { route: 'pending', ...common } }];\nreturn [{ json: { route: 'ignore', reason: 'unknown_mode' } }];"
      },
      "id": "249f2966-93e8-4a93-a6bc-35e166b4dbb3",
      "name": "Classify & Route",
      "type": "n8n-nodes-base.code",
