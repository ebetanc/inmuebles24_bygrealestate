    {
      "parameters": {
        "jsCode": "// Forward lead message to assigned agent via Evolution.\n// In human mode, the bot acts as a relay.\nconst data = $input.first().json;\n\nconst forwardBody = [\n  `Mensaje de ${data.pushName || 'Lead'} (${data.phone}):`,\n  ``,\n  data.text\n].join('\\n');\n\nreturn [{\n  json: {\n    number: data.assigned_agent_phone,\n    text: forwardBody,\n    conversation_id: data.conversation_id,\n    phone: data.phone\n  }\n}];"
      },
      "id": "eb8bce0a-459d-4a38-b9bc-b4a730e63587",
      "name": "Build Forward Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.number }}\",\n  \"text\": {{ JSON.stringify($json.text) }}\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "1500f637-802c-4f18-849a-36fc4a512883",
      "name": "Send Forward via Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        420
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
