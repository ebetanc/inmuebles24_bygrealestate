        "query": "SELECT\n  nq.id,\n  nq.conversation_id,\n  nq.source,\n  nq.lead_phone,\n  nq.lead_name,\n  nq.property_id,\n  nq.lead_email,\n  nq.temperature,\n  nq.bot_summary,\n  nq.queued_at\nFROM night_queue nq\nWHERE nq.processed = FALSE\nORDER BY nq.queued_at;",
        "options": {}
      },
