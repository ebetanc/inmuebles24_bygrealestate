      "name": "Fetch Pending Night Queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 200],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  COUNT(*) AS total_night_conversations,\n  COUNT(*) FILTER (WHERE source = 'inmuebles24') AS from_inmuebles24,\n  COUNT(*) FILTER (WHERE source = 'easybroker') AS from_easybroker,\n  COUNT(*) FILTER (WHERE source = 'whatsapp_direct') AS from_whatsapp_direct\nFROM conversations\nWHERE arrived_during = 'night'\n  AND created_at >= (NOW() AT TIME ZONE 'America/Mexico_City')::date - INTERVAL '3 hours';",
        "options": {}
      },
      "id": "wf7-0004-4000-8000-000000000004",
      "name": "Fetch Night Stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 400],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Build the morning report message for the manager.\n// Inputs: night_queue leads + night conversation stats.\n\nconst queueItems = $('Fetch Pending Night Queue').all().map(i => i.json);\nconst stats = $('Fetch Night Stats').first().json;\n\nconst totalQueued = queueItems.length;\nconst totalConvs = parseInt(stats.total_night_conversations || 0);\nconst fromInmuebles = parseInt(stats.from_inmuebles24 || 0);\nconst fromEasyBroker = parseInt(stats.from_easybroker || 0);\nconst fromWhatsApp = parseInt(stats.from_whatsapp_direct || 0);\n\n// Build header\nconst lines = [];\nlines.push('===========================');\nlines.push('REPORTE MATUTINO');\nlines.push(new Date().toLocaleDateString('es-MX', { timeZone: 'America/Mexico_City', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }));\nlines.push('===========================');\nlines.push('');\n\n// Night stats summary\nlines.push(`Conversaciones nocturnas: ${totalConvs}`);\nlines.push(`Leads en cola pendiente: ${totalQueued}`);\nlines.push('');\n\nif (totalConvs > 0 || totalQueued > 0) {\n  lines.push('--- Desglose por fuente ---');\n  if (fromInmuebles > 0) lines.push(`  Inmuebles24: ${fromInmuebles}`);\n  if (fromEasyBroker > 0) lines.push(`  EasyBroker: ${fromEasyBroker}`);\n  if (fromWhatsApp > 0) lines.push(`  WhatsApp directo: ${fromWhatsApp}`);\n  lines.push('');\n}\n\n// Detail each queued lead\nif (totalQueued > 0) {\n  lines.push('--- Leads en cola ---');\n  lines.push('');\n  queueItems.forEach((lead, idx) => {\n    lines.push(`${idx + 1}. ${lead.lead_name || 'Sin nombre'}`);\n    lines.push(`   Tel: ${lead.lead_phone}`);\n    if (lead.property_id) lines.push(`   Propiedad: ${lead.property_id}`);\n    if (lead.temperature) lines.push(`   Temperatura: ${lead.temperature.toUpperCase()}`);\n    if (lead.source) lines.push(`   Fuente: ${lead.source}`);\n    if (lead.bot_summary) {\n      lines.push(`   Resumen bot: ${lead.bot_summary}`);\n    }\n    lines.push('');\n  });\n} else {\n  lines.push('No hay leads pendientes en la cola nocturna.');\n  lines.push('');\n}\n\nlines.push('El proceso TOMO automatico se ejecutara a las 8:05 AM.');\n\nconst reportText = lines.join('\\n');\n\nreturn [{\n  json: {\n    report_text: reportText,\n    total_queued: totalQueued,\n    total_conversations: totalConvs\n  }\n}];"
      },
      "id": "wf7-0005-4000-8000-000000000005",
      "name": "Build Morning Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300]
    },
