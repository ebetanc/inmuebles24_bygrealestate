{
  "name": "WF13 - Directed Owner Notify",
  "nodes": [
    {
      "parameters": {"inputSource": "passthrough"},
      "id": "wf13-trigger",
      "name": "When Called by Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const input=$input.first().json; const opportunityId=Number(input.opportunity_id); const tier=String(input.routing_tier||'owner');\nif(!Number.isSafeInteger(opportunityId)||opportunityId<=0) throw new Error('valid opportunity_id required');\nif(!['owner','primary_guard','backup_guard'].includes(tier)) throw new Error('invalid routing tier');\nconst number=input.owner_number||input.recipient_number||null; if(!input.attempt_id&&!number) throw new Error('recipient number required');\nconst button_id=`claim:${opportunityId}:${tier}`; const text=[`Nuevo prospecto para ${input.property_title||'una propiedad'}`,`Lead: ${input.lead_name||'Sin nombre'}`,'Tienes 5 minutos desde la entrega confirmada.'].join('\\n');\nreturn [{json:{...input,opportunity_id:opportunityId,routing_tier:tier,button_id,text,number,target_agent_id:input.owner_agent_id||input.agent_id||null}}];"
      },
      "id": "wf13-build-owner-offer",
      "name": "Build Owner Offer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {"operation": "executeQuery", "query": "WITH prepared AS (SELECT d.* FROM public.create_delivery_attempt($1::bigint,$6,'offer:'||$1::text||':'||$6,$8,$2) d WHERE $5::bigint IS NULL UNION ALL SELECT a.*,TRUE AS should_send FROM public.lead_routing_delivery_attempts a JOIN public.lead_routing_opportunities o ON o.current_delivery_attempt_id=a.attempt_id JOIN public.agents g ON g.agent_id=a.target_agent_id AND g.is_available=true AND g.whatsapp_number=a.target_number WHERE $5::bigint IS NOT NULL AND a.attempt_id=$5::bigint AND a.opportunity_id=$1::bigint AND a.routing_tier=$6 AND a.status='requested' AND a.provider_message_id IS NULL AND a.lease_token=$7 AND a.lease_expires_at>NOW()) SELECT prepared.*,target_number AS number,$3 AS text,$4 AS button_id FROM prepared;", "options": {"queryReplacement": "={{ [$json.opportunity_id, $json.number, $json.text, $json.button_id, $json.attempt_id || null, $json.routing_tier, $json.lease_token || null, $json.target_agent_id || null] }}"}},
      "id": "wf13-create-attempt",
      "name": "Create Delivery Attempt",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [700, 300],
      "credentials": {"postgres": {"id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "Postgres - Supabase"}}
    },
    {
      "parameters": {"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict"},"conditions":[{"id":"wf13-should-send-true","leftValue":"={{ $json.should_send }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},
      "id": "wf13-should-send",
      "name": "Should Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [820,300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WA_CLOUD_API_BASE_URL + \"/\" + $env.WA_API_VERSION + \"/\" + $env.WA_PHONE_NUMBER_ID + \"/messages\" }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "=Bearer {{ $env.WA_ACCESS_TOKEN }}"}, {"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.number }}\",\n  \"type\": \"interactive\",\n  \"interactive\": {\n    \"type\": \"button\",\n    \"body\": { \"text\": {{ JSON.stringify($json.text) }} },\n    \"action\": { \"buttons\": [{ \"type\": \"reply\", \"reply\": { \"id\": \"{{ $json.button_id }}\", \"title\": \"Tomar prospecto\" } }] }\n  }\n}",
        "options": {"timeout": 15000}
      },
      "id": "wf13-send-owner-offer",
      "name": "Send Owner Offer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300],
      "continueOnFail": true
    },
    {"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict"},"conditions":[{"id":"wf13-has-wamid","leftValue":"={{ $json.messages && $json.messages[0] && $json.messages[0].id }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"}},"id":"wf13-send-succeeded","name":"Provider Accepted Send?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1120,300]},
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.bind_delivery_message($1::bigint, $2, $3);",
        "options": {"queryReplacement": "={{ [$('Create Delivery Attempt').first().json.attempt_id, $json.messages[0].id, $('Create Delivery Attempt').first().json.lease_token] }}"}
      },
      "id": "wf13-persist-request",
      "name": "Bind Provider Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1340, 220],
      "credentials": {"postgres": {"id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "Postgres - Supabase"}}
    },
    {"parameters":{"operation":"executeQuery","query":"SELECT * FROM public.fail_unbound_delivery_attempt($1::bigint, $2, $3);","options":{"queryReplacement":"={{ [$('Create Delivery Attempt').first().json.attempt_id, String($json.error && $json.error.message || 'provider_send_failed'), $('Create Delivery Attempt').first().json.lease_token] }}"}},"id":"wf13-fail-attempt","name":"Fail Unbound Attempt","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1340,420],"credentials":{"postgres":{"id":"REPLACE_WITH_POSTGRES_CREDENTIAL_ID","name":"Postgres - Supabase"}}
    },
    {"parameters":{},"id":"wf13-skip-send","name":"End (Already Handled)","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1040,460]}
  ],
  "connections": {
    "When Called by Router": {"main": [[{"node": "Build Owner Offer", "type": "main", "index": 0}]]},
    "Build Owner Offer": {"main": [[{"node": "Create Delivery Attempt", "type": "main", "index": 0}]]},
    "Create Delivery Attempt": {"main": [[{"node": "Should Send?", "type": "main", "index": 0}]]},
    "Should Send?": {"main": [[{"node": "Send Owner Offer", "type": "main", "index": 0}],[{"node":"End (Already Handled)","type":"main","index":0}]]},
    "Send Owner Offer": {"main": [[{"node": "Provider Accepted Send?", "type": "main", "index": 0}]]},
    "Provider Accepted Send?": {"main": [[{"node": "Bind Provider Message", "type": "main", "index": 0}], [{"node": "Fail Unbound Attempt", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder":"v1","saveExecutionProgress":false,"saveManualExecutions":false,"saveDataErrorExecution":"none","saveDataSuccessExecution":"none"}
}
