    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst incoming = $input.first();\nconst item = incoming.json || {};\nconst headers = item.headers || {};\nconst signature = String(headers['x-hub-signature-256'] || headers['X-Hub-Signature-256'] || '');\nconst encoded = incoming.binary?.data?.data;\nconst secret = $env.WA_WEBHOOK_SECRET;\nif (typeof encoded !== 'string' || !secret || !signature.startsWith('sha256=')) return [{ json: { signature_valid: false, statusCode: 401, reason: 'invalid_webhook_signature' } }];\nconst raw = Buffer.from(encoded, 'base64');\nlet body;\ntry { body = JSON.parse(raw.toString('utf8')); } catch { return [{ json: { signature_valid: false, statusCode: 400, reason: 'invalid_json' } }]; }\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst a = Buffer.from(signature), b = Buffer.from(expected);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return [{ json: { signature_valid: false, statusCode: 401, reason: 'invalid_webhook_signature' } }];\nreturn [{ json: { signature_valid: true, body, raw_body: raw.toString('utf8') } }];"
      },
      "id": "wf22-verify-signature",
      "name": "Verify Meta Signature",
      "type": "n8n-nodes-base.code",
