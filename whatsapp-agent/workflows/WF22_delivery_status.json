    {"parameters":{"jsCode":"const body=$input.first().json.body;\nconst value=body.entry?.[0]?.changes?.[0]?.value||{};\nconst s=value.statuses?.[0]||{};\nconst message_id=String(s.id||''); const status=String(s.status||'');\nif(!message_id||!['sent','delivered','failed'].includes(status)) return [{json:{valid:false}}];\nconst ts=Number(s.timestamp); const evidence={status};\nif(Array.isArray(s.errors)) evidence.error_codes=s.errors.map(e=>String(e.code||'')).filter(Boolean).slice(0,5);\nreturn [{json:{valid:true,message_id,status,provider_timestamp:Number.isFinite(ts)?new Date(ts*1000).toISOString():null,evidence}}];"},"id":"wf22-parse-status","name":"Parse Whitelisted Status","type":"n8n-nodes-base.code","typeVersion":2,"position":[680,300]},
