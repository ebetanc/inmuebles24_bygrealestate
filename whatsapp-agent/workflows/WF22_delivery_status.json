      "parameters": {
        "jsCode": "return $input.all().map(i => { const j = i.json || {}; const p = j.sanitized_payload || {}; const event = p.event || p; const value = j.event_kind === 'message' ? { messages: [event] } : { statuses: [event] }; const body = { object: 'whatsapp_business_account', entry: [{ changes: [{ value }] }] }; return { json: { ...j, kind: j.event_kind, body, event, message_id: j.wamid, context_id: p.context_id || event.context?.id || null, webhook_event_id: j.webhook_event_id, lease_token: j.lease_token } }; });"
