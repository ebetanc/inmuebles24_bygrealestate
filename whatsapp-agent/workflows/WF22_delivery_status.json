    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nreturn $input.all().filter(i => i.json.kind !== 'ignore').map(i => {\n  const j = i.json || {}; const event = j.event || {};\n  const kind = String(j.kind || ''); const wamid = String(j.message_id || event.id || '');\n  const status_name = kind === 'status' ? String(event.status || '') : null;\n  const raw = String(j.raw_body || '');\n  const payload_sha256 = crypto.createHash('sha256').update(raw, 'utf8').digest('hex');\n  const idempotency_key = 'meta:' + kind + ':' + wamid + ':' + (status_name || 'message');\n  return { json: { ...j, kind, wamid, status_name, provider_timestamp: event.timestamp ? new Date(Number(event.timestamp) * 1000).toISOString() : null, payload_sha256, idempotency_key, received_at: new Date().toISOString(), sanitized_payload: { event, kind, wamid, status_name, context_id: j.context_id || null } } };\n});"
      },
      "id": "wf22-normalize-inbox-event",
