      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst body = input.body || {};\nconst events = [];\nfor (const entry of Array.isArray(body.entry) ? body.entry : []) {\n  for (const change of Array.isArray(entry.changes) ? entry.changes : []) {\n    const value = change.value || {};\n    for (const status of Array.isArray(value.statuses) ? value.statuses : []) {\n      events.push({ kind: 'status', body, event: status, message_id: String(status.id || ''), raw_body: input.raw_body || null });\n    }\n    for (const message of Array.isArray(value.messages) ? value.messages : []) {\n      events.push({ kind: 'message', body, event: message, message_id: String(message.id || ''), context_id: message.context?.id ? String(message.context.id) : null, raw_body: input.raw_body || null });\n    }\n  }\n}\nreturn events.length ? events.map(event => ({ json: event })) : [{ json: { kind: 'ignore', body, raw_body: input.raw_body || null } }];"
      },
