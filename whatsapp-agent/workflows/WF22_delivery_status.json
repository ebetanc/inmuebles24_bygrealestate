    {"parameters":{"jsCode":"const crypto=require('crypto');\nconst item=$input.first(); const headers=item.json.headers||{}; const signature=String(headers['x-hub-signature-256']||headers['X-Hub-Signature-256']||'');\nconst encoded=item.binary?.data?.data; const secret=$env.WA_WEBHOOK_SECRET;\nif(typeof encoded!=='string'||!secret||!signature.startsWith('sha256=')) throw new Error('invalid webhook signature');\nconst raw=Buffer.from(encoded,'base64'); const expected='sha256='+crypto.createHmac('sha256',secret).update(raw).digest('hex'); const a=Buffer.from(signature),b=Buffer.from(expected);\nif(a.length!==b.length||!crypto.timingSafeEqual(a,b)) throw new Error('invalid webhook signature');\nreturn [{json:{body:JSON.parse(raw.toString('utf8'))}}];"},"id":"wf22-verify-signature","name":"Verify Meta Signature","type":"n8n-nodes-base.code","typeVersion":2,"position":[460,300]},
