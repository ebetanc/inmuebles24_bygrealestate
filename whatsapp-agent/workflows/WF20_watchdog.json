      "id": "9a1b0c1e-1111-4a1a-8000-000000000007",
      "name": "Manual (prueba)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET LOCAL statement_timeout = '8s'; WITH i24 AS (\n  -- Tokko (WF25) replaced the Inmuebles24 scraper on 2026-10-10.\n  SELECT max(created_at) AS last_ok FROM public.tokko_shadow_leads\n),\neb AS (\n  SELECT max(completed_at) AS last_ok\n  FROM scrape_logs\n  WHERE status='ok' AND metadata->>'source'='easybroker'\n),\nerrs AS (\n  SELECT count(*) AS n\n  FROM scrape_logs\n  WHERE status IN ('error','auth_error') AND completed_at > now() - interval '1 hour'\n)\nSELECT\n  i24.last_ok AS i24_last_ok,\n  EXTRACT(EPOCH FROM (now() - i24.last_ok))/60 AS i24_minutes_since,\n  eb.last_ok AS eb_last_ok,\n  EXTRACT(EPOCH FROM (now() - eb.last_ok))/60 AS eb_minutes_since,\n  errs.n AS recent_error_count\nFROM i24, eb, errs;",
        "options": {
          "connectionTimeout": 8
        }
      },
      "id": "9a1b0c1e-1111-4a1a-8000-000000000002",
      "name": "Check scraper health",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        16
      ],
      "credentials": {
        "postgres": {
          "id": "dEHKygi1neTNvPtH",
          "name": "Postgres account BYG project"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst reasons = [];\nconst i24Min = row.i24_last_ok ? Number(row.i24_minutes_since) : null;\nconst ebMin = row.eb_last_ok ? Number(row.eb_minutes_since) : null;\n// ponytail: EB intake stopped 2026-07-15 (client paused EasyBroker). Flip true to re-enable EB staleness alert.\nconst EB_ENABLED = false;\nconst errCount = Number(row.recent_error_count || 0);\n// Tokko (WF25) replaced the i24 scraper 2026-10-10; leads arrive every day, so 24 h of silence means the Gmail forward or WF25 broke.\nif (i24Min === null || i24Min > 1440) {\n  reasons.push(`Tokko: ${i24Min === null ? 'ningun aviso registrado' : 'ultimo aviso hace ' + Math.round(i24Min / 60) + ' h'} (umbral 24 h)`);\n}\nif (EB_ENABLED && (ebMin === null || ebMin > 45)) {\n  reasons.push(`Scraper EasyBroker: ${ebMin === null ? 'sin corridas ok registradas' : 'ultima ok hace ' + Math.round(ebMin) + ' min'} (umbral 45 min)`);\n}\nif (errCount >= 3) {\n  reasons.push(`${errCount} corridas con error/auth_error en la ultima hora`);\n}\n\nconst alert = reasons.length > 0;\nconst subject = alert\n  ? `⚠️ BYG watchdog: ${reasons.length} alerta(s)`\n  : 'BYG watchdog: ok';\nconst body = reasons.map(r => `- ${r}`).join('<br>');\n\nreturn [{ json: { alert, subject, body, i24Min, ebMin, errCount } }];"
      },
