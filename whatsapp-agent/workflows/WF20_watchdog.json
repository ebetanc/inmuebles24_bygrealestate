    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET LOCAL statement_timeout = '8s'; WITH recent_failures AS (\n  SELECT event_id, occurred_at,\n         COALESCE(metadata->>'reason', event_type) AS reason\n  FROM public.lead_routing_events\n  WHERE event_type IN ('delivery_failed', 'unassigned_alerted')\n    AND occurred_at > now() - interval '10 minutes'\n  ORDER BY occurred_at\n)\nSELECT r.event_id, r.occurred_at,\n       s.status, s.reason, s.entered_at, s.operational_owner, s.acknowledged, s.just_entered\nFROM recent_failures r,\nLATERAL public.report_routing_failure(r.reason, 'wf20:' || r.event_id, r.occurred_at) s;",
        "options": {
          "connectionTimeout": 8
        }
      },
