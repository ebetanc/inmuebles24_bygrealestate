                                   ],
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
                                                           "name":  "Postgres - Supabase"
                                                       }
                                      }
                  },
                  {
                      "parameters":  {
                                         "conditions":  {
                                                            "options":  {
                                                                            "caseSensitive":  true,
                                                                            "typeValidation":  "strict",
                                                                            "leftValue":  ""
