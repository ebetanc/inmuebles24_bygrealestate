{
    "name":  "WF2 - Lead Intake (Evolution)",
    "nodes":  [
                  {
                      "parameters":  {
                                         "inputSource":  "passthrough"
                                     },
                      "id":  "60e4391a-4366-4e7f-8458-37ec1919faff",
                      "name":  "When Called by WF1",
                      "type":  "n8n-nodes-base.executeWorkflowTrigger",
                      "typeVersion":  1,
                      "position":  [
                                       200,
                                       300
                                   ],
                      "notes":  "Input from WF1 (new lead via WhatsApp):\n{\n  phone: \u00275215512345678\u0027,\n  pushName: \u0027Maria Garcia\u0027,\n  text: \u0027Hola, me interesa la propiedad en Polanco\u0027,\n  messageId: \u00273EB0A0...\u0027\n}"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Try to extract a property reference from the lead\u0027s first message.\nconst data = $input.first().json;\nconst text = data.text || \u0027\u0027;\n\n// Pattern 1: EasyBroker ID (EB-XXXXX)\nconst ebMatch = text.match(/EB-[A-Z0-9]+/i);\n\n// Pattern 2: URL containing a property reference\nconst urlMatch = text.match(/https?:\\/\\/[^\\s]+/i);\n\n// Pattern 3: Keywords to search listings\nconst searchTerms = text\n  .replace(/hola|buenos dias|buenas tardes|hi|hello|me interesa|quiero|informacion|info/gi, \u0027\u0027)\n  .trim();\n\nreturn [{\n  json: {\n    phone: data.phone,\n    pushName: data.pushName,\n    text: data.text,\n    messageId: data.messageId,\n    extracted_property_id: ebMatch ? ebMatch[0] : null,\n    extracted_url: urlMatch ? urlMatch[0] : null,\n    search_terms: searchTerms.substring(0, 100)\n  }\n}];"
                                     },
                      "id":  "5301e0db-b2e2-4b19-8e70-7d0e14c9e340",
                      "name":  "Extract Property Context",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       420,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "-- Create a new conversation and check day/night in one query.\n-- Migration 0005 dropped UNIQUE on lead_phone, so we always INSERT.\nINSERT INTO conversations (\n  lead_phone, lead_name, current_property, mode, source, arrived_during\n)\nVALUES (\n  $1, $2, $3,\n  CASE WHEN is_daytime() THEN \u0027pending_assignment\u0027 ELSE \u0027night_queued\u0027 END,\n  \u0027whatsapp_direct\u0027,\n  CASE WHEN is_daytime() THEN \u0027day\u0027 ELSE \u0027night\u0027 END\n)\nRETURNING\n  conversation_id, lead_phone, lead_name, current_property,\n  mode, arrived_during, is_daytime() AS is_day;",
                                         "options":  {
                                                         "queryReplacement":  "={{ $json.phone }},={{ $json.pushName || null }},={{ $json.extracted_property_id || null }}"
                                                     }
                                     },
                      "id":  "45d9e6f1-064e-4960-b36a-863f6e790e50",
                      "name":  "Create Conversation",
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.5,
                      "position":  [
                                       640,
                                       300
                                   ],
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
                                                           "name":  "Postgres - Supabase"
                                                       }
                                      }
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "-- Link the inbound message (inserted by WF1 with conversation_id=NULL)\n-- to the newly created conversation.\nUPDATE messages\nSET conversation_id = $1::uuid, sender_type = \u0027lead\u0027\nWHERE msg_external_id = $2\nRETURNING message_id;",
                                         "options":  {
                                                         "queryReplacement":  "={{ $json.conversation_id }},={{ $(\u0027Extract Property Context\u0027).first().json.messageId }}"
                                                     }
                                     },
                      "id":  "d754bef1-b95d-47b5-ae78-be78249495e3",
                      "name":  "Link Message to Conversation",
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.5,
                      "position":  [
                                       860,
                                       300
                                   ],
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
                                                           "name":  "Postgres - Supabase"
                                                       }
                                      },
                      "continueOnFail":  true
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "-- Find a matching property from the listings table.\n-- M5 fix: require search_terms \u003e= 5 chars to prevent overly broad ILIKE matches.\nSELECT id, listing_hash, title, price, price_numeric, currency,\n       location, property_type, operation_type, bedrooms, bathrooms,\n       area_m2, description, url, image_url\nFROM listings\nWHERE is_active = true\n  AND (\n    listing_hash = $1\n    OR (length($2) \u003e= 5 AND title ILIKE \u0027%\u0027 || $2 || \u0027%\u0027)\n    OR (length($2) \u003e= 5 AND location ILIKE \u0027%\u0027 || $2 || \u0027%\u0027)\n    OR url ILIKE \u0027%\u0027 || $1 || \u0027%\u0027\n  )\nORDER BY last_seen_at DESC\nLIMIT 1;",
                                         "options":  {
                                                         "queryReplacement":  "={{ $(\u0027Extract Property Context\u0027).first().json.extracted_property_id || \u0027\u0027 }},={{ $(\u0027Extract Property Context\u0027).first().json.search_terms || \u0027\u0027 }}"
                                                     }
                                     },
                      "id":  "3fa459c5-6807-4c5d-8057-dc83800c042c",
                      "name":  "Find Matching Property",
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.5,
                      "position":  [
                                       1080,
                                       300
                                   ],
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
                                                           "name":  "Postgres - Supabase"
                                                       }
                                      },
                      "alwaysOutputData":  true
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Prepare routing/night-queue data and cache the property.\nconst conv = $(\u0027Create Conversation\u0027).first().json;\nconst property = $(\u0027Find Matching Property\u0027).first().json;\nconst context = $(\u0027Extract Property Context\u0027).first().json;\n\nconst hasProperty = !!(property \u0026\u0026 property.title);\nconst isDay = conv.is_day !== false;\n\nconst propertyId = hasProperty\n  ? (property.listing_hash || `listing-${property.id}`)\n  : (context.extracted_property_id || \u0027unknown\u0027);\n\nconst propertyTitle = hasProperty\n  ? property.title\n  : \u0027Propiedad (pendiente de identificar)\u0027;\n\nconst propertyPrice = hasProperty\n  ? `${property.price || \u0027\u0027} ${property.currency || \u0027MXN\u0027}`\n  : \u0027Precio por confirmar\u0027;\n\nconst cachePayload = hasProperty ? {\n  title: property.title,\n  price: property.price,\n  price_numeric: property.price_numeric,\n  currency: property.currency,\n  location: property.location,\n  property_type: property.property_type,\n  operation_type: property.operation_type,\n  bedrooms: property.bedrooms,\n  bathrooms: property.bathrooms,\n  area_m2: property.area_m2,\n  description: property.description,\n  url: property.url,\n  image_url: property.image_url\n} : null;\n\nreturn [{\n  json: {\n    // Routing\n    is_day: isDay,\n    conversation_id: conv.conversation_id,\n    lead_phone: conv.lead_phone,\n    identity_phone: (() =\u003e { const raw = String(context.phone || \u0027\u0027).trim(); return /^\\\\+[0-9][0-9 ()-]*[0-9]$/.test(raw) ? raw.replace(/[ ()-]/g, \u0027\u0027) : null; })(),\n    lead_name: conv.lead_name || context.pushName || null,\n    property_id: propertyId,\n    property_title: propertyTitle,\n    property_price: propertyPrice,\n    assigned_agent_id: null,\n    // For caching\n    cache_property_id: propertyId,\n    cache_payload: cachePayload,\n    has_property: hasProperty\n  }\n}];"
                                     },
                      "id":  "485ee193-3a66-479c-9f49-b68b052ace36",
                      "name":  "Prepare Routing Data",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1300,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT u.*, $5::boolean AS is_day, $6 AS lead_phone, $7 AS lead_name, $2 AS property_id, $8 AS property_title, $9 AS property_price, $10 AS cache_property_id, $11::jsonb AS cache_payload, $12::boolean AS has_property, NULL::text AS assigned_agent_id\nFROM upsert_lead_opportunity($1::uuid, $2, NULL, NULL, $3, \u0027whatsapp_direct\u0027, $4, CASE WHEN $5::boolean THEN \u0027captured\u0027 ELSE \u0027queued_night\u0027 END) u;",
                                         "options":  {
                                                         "queryReplacement":  "={{ $json.conversation_id }},={{ $json.property_id }},={{ $json.identity_phone }},={{ $(\u0027Extract Property Context\u0027).first().json.messageId }},={{ $json.is_day }},={{ $json.lead_phone }},={{ $json.lead_name }},={{ $json.property_title }},={{ $json.property_price }},={{ $json.cache_property_id }},={{ JSON.stringify($json.cache_payload || {}) }},={{ $json.has_property }}"
                                                     }
                                     },
                      "id":  "lrv2-006-wf2-upsert-opportunity",
                      "name":  "Upsert Canonical Opportunity",
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.5,
                      "position":  [
                                       1410,
