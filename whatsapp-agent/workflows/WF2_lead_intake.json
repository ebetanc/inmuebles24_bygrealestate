                                                            "conditions":  [
                                                                               {
                                                                                   "id":  "is-day-check",
                                                                                   "leftValue":  "={{ $json.is_day }}",
                                                                                   "rightValue":  true,
                                                                                   "operator":  {
                                                                                                    "type":  "boolean",
                                                                                                    "operation":  "true"
                                                                                                }
                                                                               }
                                                                           ],
                                                            "combinator":  "and"
                                                        }
                                     },
                      "id":  "c1d2e3f4-0001-4000-8000-000000000001",
                      "name":  "Day or Night?",
