                                         "query":  "-- Insert into night queue for morning auto-TOMO.\nINSERT INTO night_queue (conversation_id, source, lead_phone, lead_name, property_id)\nVALUES ($1::uuid, \u0027whatsapp_direct\u0027, $2, $3, $4);",
                                         "options":  {
