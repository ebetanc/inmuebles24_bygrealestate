{
    "name":  "WF12 - Owner Resolver (EasyBroker tags)",
    "nodes":  [
                  {
                      "parameters":  {
                                         "inputSource":  "passthrough"
                                     },
                      "id":  "c1c2c3c4-0001-4000-8000-000000000001",
                      "name":  "When Called",
                      "type":  "n8n-nodes-base.executeWorkflowTrigger",
                      "typeVersion":  1,
                      "position":  [
                                       200,
                                       300
                                   ],
                      "notes":  "Input: property_public_id, conversation_id, opportunity_id. Output: resolved, reason, failure_detail, observed_tag and validated owner. Strict tags[0]; unresolved routes to primary guard."
                  },
                  {
                      "parameters":  {
                                         "method":  "GET",
                                         "url":  "={{ $env.EASYBROKER_BASE }}/properties/{{ $json.property_public_id }}",
                                         "sendHeaders":  true,
                                         "headerParameters":  {
                                                                  "parameters":  [
                                                                                     {
                                                                                         "name":  "X-Authorization",
                                                                                         "value":  "={{ $env.EASYBROKER_API_KEY }}"
                                                                                     },
                                                                                     {
                                                                                         "name":  "Accept",
                                                                                         "value":  "application/json"
                                                                                     }
                                                                                 ]
                                                              },
                                         "options":  {
                                                         "timeout":  15000
                                                     }
                                     },
                      "id":  "c1c2c3c4-0002-4000-8000-000000000002",
                      "name":  "Fetch EasyBroker Property",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       440,
                                       300
                                   ],
                      "continueOnFail":  true,
                      "alwaysOutputData":  true
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const trig = $(\u0027When Called\u0027).first().json;\nconst resp = $input.first().json || {};\nconst tags = Array.isArray(resp.tags) ? resp.tags : [];\nconst firstTag = tags.length ? String(tags[0]) : null;\nconst tags_pg = firstTag === null ? \u0027{}\u0027 : \u0027{\"\u0027 + firstTag.replace(/\\\\/g, \u0027\\\\\\\\\u0027).replace(/\"/g, \u0027\\\\\"\u0027) + \u0027\"}\u0027;\nreturn [{ json: { ...trig, tags, observed_tag: firstTag, tags_pg } }];"
                                     },
                      "id":  "c1c2c3c4-0003-4000-8000-000000000003",
                      "name":  "Extract Tags",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT * FROM public.resolve_first_property_tag($1, $2::text[]);",
                                         "options":  {
                                                         "queryReplacement":  "={{ $json.property_public_id }},={{ $json.tags_pg }}"
                                                     }
                                     },
                      "id":  "c1c2c3c4-0004-4000-8000-000000000004",
                      "name":  "Resolve Owner Agent",
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.5,
                      "position":  [
                                       920,
                                       300
                                   ],
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
                                                           "name":  "Postgres - Supabase"
                                                       }
                                      },
                      "alwaysOutputData":  true
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const ctx = $(\u0027Extract Tags\u0027).first().json;\nconst row = $input.first().json || {};\nreturn [{ json: {\n  conversation_id: ctx.conversation_id || null,\n  opportunity_id: ctx.opportunity_id || null,\n  property_public_id: ctx.property_public_id || null,\n  tags: ctx.tags,\n  observed_tag: row.observed_tag || ctx.observed_tag || null,\n  resolved: row.resolved === true,\n  reason: row.reason || \u0027missing_owner_data\u0027,\n  failure_detail: row.failure_detail || null,\n  owner_agent_id: row.owner_agent_id || null,\n  owner_name: row.owner_name || null,\n  owner_number: row.owner_number || null\n} }];"
                                     },
                      "id":  "c1c2c3c4-0005-4000-8000-000000000005",
                      "name":  "Shape Output",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1160,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const input = $input.first().json;\nconst code = String(input.property_public_id || \u0027\u0027).trim().toUpperCase();\nreturn [{ json: { ...input, property_public_id: code, valid_eb_code: /^EB-[A-Z0-9]{4,}$/.test(code) } }];"
                                     },
                      "id":  "lrv2-007-validate-eb-code",
                      "name":  "Validate EB Code",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       320,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "conditions":  {
                                                            "options":  {
                                                                            "caseSensitive":  true,
                                                                            "typeValidation":  "strict",
                                                                            "leftValue":  ""
                                                                        },
                                                            "conditions":  [
                                                                               {
                                                                                   "id":  "valid-eb-code-condition",
                                                                                   "leftValue":  "={{ $json.valid_eb_code }}",
                                                                                   "rightValue":  true,
                                                                                   "operator":  {
                                                                                                    "type":  "boolean",
                                                                                                    "operation":  "true"
                                                                                                }
                                                                               }
                                                                           ],
                                                            "combinator":  "and"
                                                        }
                                     },
                      "id":  "lrv2-007-valid-eb-code",
                      "name":  "Valid EB Code?",
                      "type":  "n8n-nodes-base.if",
                      "typeVersion":  2.2,
                      "position":  [
                                       400,
                                       300
                                   ]
                  }
              ],
    "connections":  {
                        "When Called":  {
                                            "main":  [
                                                         [
                                                             {
                                                                 "node":  "Validate EB Code",
                                                                 "type":  "main",
                                                                 "index":  0
                                                             }
                                                         ]
                                                     ]
                                        },
                        "Fetch EasyBroker Property":  {
                                                          "main":  [
                                                                       [
                                                                           {
                                                                               "node":  "Extract Tags",
                                                                               "type":  "main",
                                                                               "index":  0
                                                                           }
                                                                       ]
                                                                   ]
                                                      },
                        "Extract Tags":  {
                                             "main":  [
                                                          [
                                                              {
                                                                  "node":  "Resolve Owner Agent",
                                                                  "type":  "main",
                                                                  "index":  0
                                                              }
                                                          ]
                                                      ]
                                         },
                        "Resolve Owner Agent":  {
                                                    "main":  [
                                                                 [
                                                                     {
                                                                         "node":  "Shape Output",
                                                                         "type":  "main",
                                                                         "index":  0
                                                                     }
                                                                 ]
                                                             ]
                                                },
                        "Validate EB Code":  {
                                                 "main":  [
                                                              [
                                                                  {
                                                                      "node":  "Valid EB Code?",
                                                                      "type":  "main",
                                                                      "index":  0
                                                                  }
                                                              ]
                                                          ]
                                             },
                        "Valid EB Code?":  {
                                               "main":  [
                                                            [
                                                                {
                                                                    "node":  "Fetch EasyBroker Property",
                                                                    "type":  "main",
                                                                    "index":  0
                                                                }
                                                            ],
                                                            [
                                                                {
                                                                    "node":  "Extract Tags",
                                                                    "type":  "main",
                                                                    "index":  0
                                                                }
                                                            ]
                                                        ]
                                           }
                    },
    "settings":  {
                     "executionOrder":  "v1",
                     "saveExecutionProgress":  true,
                     "saveManualExecutions":  true
                 }
}