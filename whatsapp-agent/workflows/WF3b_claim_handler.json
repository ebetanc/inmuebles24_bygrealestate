{
  "name": "WF3b - Claim Handler",
  "nodes": [
    {
      "parameters": { "inputSource": "passthrough" },
      "id": "trigger-wf3b",
      "name": "When Called by WF1 (Inbound Router)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "notes": "Input from WF1 when an agent sends /TOMO-([A-Z0-9]{4})/:\n{\n  agent_id: 'agent_yolanda',\n  agent_name: 'Yolanda',\n  agent_phone: '+5215500000001',\n  short_code: 'AB12',\n  raw_message: 'TOMO-AB12',\n  twilio_sid: 'SM...'\n}"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- ATOMIC CLAIM: the WHERE status='open' inside the UPDATE is what makes\n-- first-reply-wins correct. Exactly one concurrent caller sees the row as\n-- 'open' and wins; others get 0 rows.\nWITH claim AS (\n  UPDATE auctions\n  SET status='claimed', winner_agent_id=$1, claimed_at=NOW()\n  WHERE short_code=$2 AND status='open' AND expires_at > NOW()\n  RETURNING auction_id, conversation_id, property_id, winner_agent_id, notified_agents\n)\nSELECT c.*, conv.lead_phone, conv.lead_name, pc.payload AS property_payload\nFROM claim c\nJOIN conversations conv ON conv.conversation_id = c.conversation_id\nLEFT JOIN properties_cache pc ON pc.property_id = c.property_id;",
        "options": { "queryReplacement": "={{ $json.agent_id }},={{ $json.short_code }}" }
      },
      "id": "pg-atomic-claim",
      "name": "Atomic Claim (WHERE status=open)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [420, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_POSTGRES_CRED_ID", "name": "Supabase Postgres" }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "is-winner",
              "leftValue": "={{ $json.auction_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-winner",
      "name": "Did This Agent Win?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversations\nSET assigned_agent_id=$1, mode='ai'\nWHERE conversation_id=$2::uuid\nRETURNING conversation_id, lead_phone, lead_name, current_property;",
        "options": { "queryReplacement": "={{ $('When Called by WF1 (Inbound Router)').item.json.agent_id }},={{ $json.conversation_id }}" }
      },
      "id": "pg-assign-conversation",
      "name": "Assign Conversation to Winner",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [860, 180],
      "credentials": {
        "postgres": { "id": "REPLACE_POSTGRES_CRED_ID", "name": "Supabase Postgres" }
      }
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Called by WF1 (Inbound Router)').first().json;\nconst claim   = $('Atomic Claim (WHERE status=open)').first().json;\n\nconst winner = {\n  purpose: 'winner_confirmation',\n  to_phone: `whatsapp:${trigger.agent_phone}`,\n  body: [\n    `✅ ¡Asignado! Lead: ${claim.lead_name || 'Sin nombre'}`,\n    `📱 Teléfono del lead: ${claim.lead_phone}`,\n    `🏠 Propiedad: ${claim.property_id}`,\n    ``,\n    `El asistente AI ya está atendiendo sus preguntas. Te contactaremos si requiere tu intervención (visita, negociación, etc.).`\n  ].join('\\n')\n};\n\nconst leadGreeting = {\n  purpose: 'lead_greeting',\n  to_phone: `whatsapp:${claim.lead_phone}`,\n  body: [\n    `¡Hola${claim.lead_name ? ' ' + claim.lead_name.split(' ')[0] : ''}! 👋`,\n    ``,\n    `Soy el asistente de la agencia. Estoy a tus órdenes para contarte sobre la propiedad ${claim.property_id}. ¿Qué te gustaría saber? (recámaras, precio, ubicación, amenidades, etc.)`\n  ].join('\\n')\n};\n\nconst losers = (claim.notified_agents || [])\n  .filter(id => id !== trigger.agent_id)\n  .map(agent_id => ({\n    purpose: 'loser_notification',\n    agent_id,\n    body: `Este lead ya fue tomado por otro asesor. ¡Suerte con el próximo! 💪`\n  }));\n\nreturn [winner, leadGreeting, ...losers].map(m => ({ json: m }));"
      },
      "id": "build-outbound",
      "name": "Build Winner/Lead/Loser Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "needs-phone-lookup",
              "leftValue": "={{ $json.purpose }}",
              "rightValue": "loser_notification",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "switch-loser-or-direct",
      "name": "Needs Phone Lookup?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1300, 180]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT whatsapp_number FROM agents WHERE agent_id = $1;",
        "options": { "queryReplacement": "={{ $json.agent_id }}" }
      },
      "id": "pg-lookup-loser-phone",
      "name": "Lookup Loser Agent Phone",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1520, 80],
      "credentials": {
        "postgres": { "id": "REPLACE_POSTGRES_CRED_ID", "name": "Supabase Postgres" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "to_phone", "name": "to_phone", "value": "=whatsapp:{{ $json.whatsapp_number }}", "type": "string" },
            { "id": "body",     "name": "body",     "value": "={{ $('Build Winner/Lead/Loser Messages').item.json.body }}", "type": "string" },
            { "id": "purpose",  "name": "purpose",  "value": "loser_notification", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-loser-payload",
      "name": "Set Loser Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1740, 80]
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineAll", "options": {} },
      "id": "merge-all-outbound",
      "name": "Merge All Outbound",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [1960, 180]
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "={{ $env.TWILIO_WHATSAPP_FROM }}",
        "to": "={{ $json.to_phone }}",
        "toWhatsapp": true,
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "twilio-send-all",
      "name": "Send All via Twilio",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [2180, 180],
      "credentials": {
        "twilioApi": { "id": "REPLACE_TWILIO_CRED_ID", "name": "Twilio" }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Called by WF1 (Inbound Router)').first().json;\nreturn [{\n  json: {\n    to_phone: `whatsapp:${trigger.agent_phone}`,\n    body: `⚠️ No pude asignarte el lead ${trigger.short_code}.\\n\\nPuede que otro asesor lo haya tomado primero, o que la subasta haya expirado. Cuando entre un nuevo lead te avisaremos.`\n  }\n}];"
      },
      "id": "build-too-late",
      "name": "Build 'Too Late' Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 420]
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "={{ $env.TWILIO_WHATSAPP_FROM }}",
        "to": "={{ $json.to_phone }}",
        "toWhatsapp": true,
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "twilio-send-too-late",
      "name": "Send 'Too Late' via Twilio",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1080, 420],
      "credentials": {
        "twilioApi": { "id": "REPLACE_TWILIO_CRED_ID", "name": "Twilio" }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "When Called by WF1 (Inbound Router)": { "main": [[{ "node": "Atomic Claim (WHERE status=open)", "type": "main", "index": 0 }]] },
    "Atomic Claim (WHERE status=open)":    { "main": [[{ "node": "Did This Agent Win?", "type": "main", "index": 0 }]] },
    "Did This Agent Win?": {
      "main": [
        [{ "node": "Assign Conversation to Winner", "type": "main", "index": 0 }],
        [{ "node": "Build 'Too Late' Message", "type": "main", "index": 0 }]
      ]
    },
    "Assign Conversation to Winner":       { "main": [[{ "node": "Build Winner/Lead/Loser Messages", "type": "main", "index": 0 }]] },
    "Build Winner/Lead/Loser Messages":    { "main": [[{ "node": "Needs Phone Lookup?", "type": "main", "index": 0 }]] },
    "Needs Phone Lookup?": {
      "main": [
        [{ "node": "Lookup Loser Agent Phone", "type": "main", "index": 0 }],
        [{ "node": "Merge All Outbound", "type": "main", "index": 1 }]
      ]
    },
    "Lookup Loser Agent Phone": { "main": [[{ "node": "Set Loser Payload", "type": "main", "index": 0 }]] },
    "Set Loser Payload":        { "main": [[{ "node": "Merge All Outbound", "type": "main", "index": 0 }]] },
    "Merge All Outbound":       { "main": [[{ "node": "Send All via Twilio", "type": "main", "index": 0 }]] },
    "Build 'Too Late' Message": { "main": [[{ "node": "Send 'Too Late' via Twilio", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true }
}
