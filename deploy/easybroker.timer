[Unit]
Description=Run the EasyBroker Buzon final-note bot every 5 min (CDMX)

[Timer]
# Final responsibility can settle after the intake window closes, so note/status
# reconciliation runs every 5 minutes all day. Night-queued leads still wait for
# the routing workflow's 08:05 release before anyone becomes responsible.
OnCalendar=*-*-* *:0/5:00 America/Mexico_City
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
