[Unit]
Description=Run the EasyBroker Buzon final-note bot every minute (CDMX)

[Timer]
# Final responsibility can settle after the intake window closes, so note/status
# effect reconciliation runs every minute. Inbox API fetch is internally gated
# to every 5 minutes. Night-queued leads still wait for
# the routing workflow's 08:05 release before anyone becomes responsible.
OnCalendar=*-*-* *:*:00 America/Mexico_City
RandomizedDelaySec=5
Persistent=true

[Install]
WantedBy=timers.target
