[Unit]
Description=Inmobiliaria24 every minute during daytime; existing night cadence

[Timer]
# Capture always runs; only notification routing changes during the night window.
OnCalendar=*-*-* 00..07,20..23:0/15:00 America/Mexico_City
OnCalendar=*-*-* 08:00:00 America/Mexico_City
OnCalendar=*-*-* 08:05..59:00 America/Mexico_City
OnCalendar=*-*-* 09..19:*:00 America/Mexico_City
RandomizedDelaySec=0
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
