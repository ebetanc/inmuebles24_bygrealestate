[Unit]
Description=Run Inmobiliaria24 scraper every 15 minutes during business hours

[Timer]
# Every 15 minutes from 8am to 7:45pm, plus a final run at 8pm (Mexico City)
OnCalendar=*-*-* 08..19:0/15:00 America/Mexico_City
OnCalendar=*-*-* 20:00:00 America/Mexico_City
# Randomize start within 60s to avoid exact-second races
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
