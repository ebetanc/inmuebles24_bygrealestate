[Unit]
Description=Inmobiliaria24 WhatsApp Webhook Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inmobiliaria24
Group=inmobiliaria24
WorkingDirectory=/opt/inmobiliaria24
EnvironmentFile=/opt/inmobiliaria24/.env
ExecStart=/opt/inmobiliaria24/.venv/bin/uvicorn inmobiliaria24.server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# Resource limits
MemoryMax=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inmobiliaria24-server

# Security hardening
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/opt/inmobiliaria24/data /opt/inmobiliaria24/logs

[Install]
WantedBy=multi-user.target
