[Unit]
Description=EasyBroker Buzon finalizer (one responsible note + Atendida)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=inmobiliaria24
WorkingDirectory=/opt/inmobiliaria24
EnvironmentFile=/opt/inmobiliaria24/.env
# EB is reachable from the Pi's own IP — do NOT route through the metered/flaky
# Mexico mobile proxy used by the Inmuebles24 scraper. Override it empty here.
Environment=CHROME_PROXY=
Environment=EB_MARK_ATTENDED=1
Environment=PYTHONPATH=/opt/inmobiliaria24/src
Environment=HOME=/opt/inmobiliaria24
# A timeout-killed run can orphan the Chrome grandchild (xvfb-run does not
# propagate SIGTERM), leaving it bound to CDP port 9223 and holding the profile
# lock — the next run then attaches to that stuck instance. Kill any stale EB
# Chrome (matched by its unique 9223 debug port, so the scraper's 9222 Chrome is
# untouched) and clear the lock before launching.
# The [r] in the pattern stops pkill -f from matching its own argv and killing
# the shell before it finishes (a literal would self-match).
ExecStartPre=-/bin/sh -c 'pkill -9 -f "[r]emote-debugging-port=9223"; rm -f /opt/inmobiliaria24/.session/eb-chrome-profile/Singleton*'
# Headful under a virtual framebuffer — EB's WAF returns 403 to headless Chrome.
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24" /opt/inmobiliaria24/.venv/bin/python -m easybroker
TimeoutStartSec=600
PrivateTmp=true

[Install]
WantedBy=multi-user.target
