[Unit]
Description=EasyBroker Buzon attend bot (set Atendida + agent note)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=inmobiliaria24
WorkingDirectory=/opt/inmobiliaria24
EnvironmentFile=/opt/inmobiliaria24/.env
# EB is reachable from the Pi's own IP — do NOT route through the metered/flaky
# Mexico mobile proxy used by the Inmuebles24 scraper. Override it empty here.
Environment=CHROME_PROXY=
Environment=EB_MARK_ATTENDED=1
Environment=PYTHONPATH=/opt/inmobiliaria24/src
Environment=HOME=/opt/inmobiliaria24
# A timeout-killed Chrome can leave a stale SingletonLock in the profile; clear
# it before launching (no EB Chrome can be running — oneshot runs never overlap).
ExecStartPre=-/bin/sh -c 'rm -f /opt/inmobiliaria24/.session/eb-chrome-profile/Singleton*'
# Headful under a virtual framebuffer — EB's WAF returns 403 to headless Chrome.
ExecStart=/usr/bin/xvfb-run -a /opt/inmobiliaria24/.venv/bin/python -m easybroker
TimeoutStartSec=600
PrivateTmp=true

[Install]
WantedBy=multi-user.target
