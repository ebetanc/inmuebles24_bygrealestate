{"updatedAt":"2026-08-14T04:37:17.680Z","createdAt":"2026-05-08T10:26:56.633Z","id":"JM2HxJxl53k4zlki","name":"WF3b - Claim Handler (Evolution)","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"inputSource":"passthrough"},"id":"0c1952e0-e484-458f-bde6-b65bf77cbbae","name":"When Called by WF1","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[200,300],"notes":"Input from WF1 when an agent sends TOMO-XXXX:\n{\n  agent_id: 'agent_yolanda',\n  agent_name: 'Yolanda',\n  agent_phone: '5215500000001',\n  short_code: 'AB12',\n  raw_message: 'TOMO-AB12',\n  messageId: '3EB0A0...'\n}"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict"},"conditions":[{"id":"wf3b-routing-v2-id","leftValue":"={{ String($json.opportunity_id || '') }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"}},"id":"wf3b-is-routing-v2","name":"Is Routing V2 Claim?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[420,300]},{"parameters":{"operation":"executeQuery","query":"SELECT * FROM public.claim_lead_opportunity($1::bigint,$2,$3,encode(digest($4,'sha256'),'hex'),$5);","options":{"queryReplacement":"={{ [$json.opportunity_id, $json.routing_tier, $json.agent_id, $json.agent_phone, $json.messageId] }}"}},"id":"wf3b-claim-routing-v2","name":"Claim Routing V2 Opportunity","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[640,120],"credentials":{"postgres":{"id":"dEHKygi1neTNvPtH","name":"Postgres account BYG project"}}},{"parameters":{"jsCode":"const trigger=$('When Called by WF1').first().json; const claim=$input.first().json;\nconst text={accepted:'Prospecto asignado. Ya puedes atenderlo.',already_assigned:'Este prospecto ya fue asignado.',expired:'La oferta ya vencio o pertenece a un turno anterior.',not_authorized:'Esta oferta no estaba dirigida a tu usuario.',delivery_pending:'La oferta aun no tiene entrega confirmada.'}[claim.claim_status]||'No fue posible procesar la aceptacion.';\nreturn [{json:{number:trigger.agent_phone,text,claim_status:claim.claim_status,opportunity_id:claim.result_opportunity_id}}];"},"id":"wf3b-build-v2-result","name":"Build Routing V2 Claim Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[860,120]},{"parameters":{"method":"POST","url":"={{ $env.WA_CLOUD_API_BASE_URL + '/' + $env.WA_API_VERSION + '/' + $env.WA_PHONE_NUMBER_ID + '/messages' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $env.WA_ACCESS_TOKEN }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.number }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": {{ JSON.stringify($json.text) }} }\n}","options":{"timeout":10000}},"id":"wf3b-send-v2-result","name":"Send Routing V2 Claim Result","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1080,120],"continueOnFail":true},{"parameters":{"operation":"executeQuery","query":"-- Legacy TOMO claim. Routing-v2 opportunities are claimed only through claim_lead_opportunity.\nWITH claim AS (\n  UPDATE auctions\n  SET status='claimed', winner_agent_id=$1, claimed_at=NOW()\n  WHERE short_code=$2 AND status='open' AND expires_at > NOW()\n    AND NOT EXISTS (\n      SELECT 1 FROM public.lead_routing_opportunities o\n      WHERE o.conversation_id=auctions.conversation_id\n        AND o.state NOT IN ('closed_won','closed_lost')\n    )\n  RETURNING auction_id, conversation_id, property_id, winner_agent_id, notified_agents\n)\nSELECT c.*, conv.lead_phone, conv.lead_name, pc.payload AS property_payload\nFROM claim c\nJOIN conversations conv ON conv.conversation_id = c.conversation_id\nLEFT JOIN properties_cache pc ON pc.property_id = c.property_id;","options":{"queryReplacement":"={{ $json.agent_id }},={{ $json.short_code }}"}},"id":"86c01b28-9da5-4402-aeff-5ae13cf77363","name":"Atomic Claim (WHERE status=open)","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[420,300],"credentials":{"postgres":{"id":"dEHKygi1neTNvPtH","name":"Postgres account BYG project"}},"alwaysOutputData":true},{"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict","version":2},"conditions":[{"id":"60c87d88-e8b4-4580-ba9a-c190d6ae6ee6","leftValue":"={{ $json.auction_id }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"id":"85cb99da-9e47-45f0-96d1-3c34d8286a33","name":"Did This Agent Win?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[640,300]},{"parameters":{"operation":"executeQuery","query":"UPDATE conversations\nSET assigned_agent_id=$1, mode='ai'\nWHERE conversation_id=$2::uuid\nRETURNING conversation_id, lead_phone, lead_name, current_property;","options":{"queryReplacement":"={{ $('When Called by WF1').item.json.agent_id }},={{ $json.conversation_id }}"}},"id":"03d4ff26-bb45-4baa-96d9-0031c56c877e","name":"Assign Conversation to Winner","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[860,180],"credentials":{"postgres":{"id":"dEHKygi1neTNvPtH","name":"Postgres account BYG project"}}},{"parameters":{"jsCode":"const trigger = $('When Called by WF1').first().json;\nconst claim   = $('Atomic Claim (WHERE status=open)').first().json;\n\nconst winner = {\n  purpose: 'winner_confirmation',\n  number: trigger.agent_phone,\n  text: [\n    `\\u2705 Asignado! Lead: ${claim.lead_name || 'Sin nombre'}`,\n    `\\u{1F4F1} Telefono del lead: ${claim.lead_phone}`,\n    `\\u{1F3E0} Propiedad: ${claim.property_id}`,\n    ``,\n    `El asistente AI ya esta atendiendo sus preguntas. Te contactaremos si requiere tu intervencion (visita, negociacion, etc.).`\n  ].join('\\n')\n};\n\nconst leadGreeting = {\n  purpose: 'lead_greeting',\n  number: claim.lead_phone,\n  text: [\n    `Hola${claim.lead_name ? ' ' + claim.lead_name.split(' ')[0] : ''}! \\u{1F44B}`,\n    ``,\n    `Soy el asistente de la agencia. Estoy a tus ordenes para contarte sobre la propiedad. Que te gustaria saber? (precio, ubicacion, recamaras, amenidades, etc.)`,\n    ``,\n    `Hi${claim.lead_name ? ' ' + claim.lead_name.split(' ')[0] : ''}! I'm the agency assistant. I'm here to help you learn about this property. What would you like to know?`\n  ].join('\\n')\n};\n\nconst losers = (claim.notified_agents || [])\n  .filter(id => id !== trigger.agent_id)\n  .map(agent_id => ({\n    purpose: 'loser_notification',\n    agent_id,\n    text: `Este lead ya fue tomado por otro asesor. Suerte con el proximo! \\u{1F4AA}`\n  }));\n\nreturn [winner, leadGreeting, ...losers].map(m => ({ json: m }));"},"id":"9127e6ce-b2ef-4daf-8722-1e1c983af051","name":"Build Winner/Lead/Loser Messages","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,180]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict","version":2},"conditions":[{"id":"f7727c4a-1403-44a9-98be-73f62aa24b68","leftValue":"={{ $json.purpose }}","rightValue":"loser_notification","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"686b0f7f-ae71-4353-9475-bee2a15daba2","name":"Needs Phone Lookup?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1300,180]},{"parameters":{"operation":"executeQuery","query":"SELECT whatsapp_number FROM agents WHERE agent_id = $1;","options":{"queryReplacement":"={{ $json.agent_id }}"}},"id":"7757b98b-9c8b-4a58-a77b-199d8e651637","name":"Lookup Loser Agent Phone","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1520,80],"credentials":{"postgres":{"id":"dEHKygi1neTNvPtH","name":"Postgres account BYG project"}}},{"parameters":{"assignments":{"assignments":[{"id":"number","name":"number","value":"={{ $json.whatsapp_number }}","type":"string"},{"id":"text","name":"text","value":"={{ $('Build Winner/Lead/Loser Messages').item.json.text }}","type":"string"},{"id":"purpose","name":"purpose","value":"loser_notification","type":"string"}]},"options":{}},"id":"2ef0db24-a3cf-42a7-83a0-0646f961ceeb","name":"Set Loser Payload","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1740,80]},{"parameters":{"mode":"append","options":{}},"id":"51b5a7db-e1b9-4b46-aee9-825e66f39b46","name":"Merge All Outbound","type":"n8n-nodes-base.merge","typeVersion":3.1,"position":[1960,180]},{"parameters":{"method":"POST","url":"={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.EVOLUTION_API_KEY }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"{{ $json.number }}\",\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"delay\": 1200\n}","options":{"timeout":15000}},"id":"3f795990-1c85-42e6-9b1c-0c3723437d80","name":"Send All via Evolution","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2180,180],"continueOnFail":true},{"parameters":{"jsCode":"const trigger = $('When Called by WF1').first().json;\nreturn [{\n  json: {\n    number: trigger.agent_phone,\n    text: `\\u26A0\\uFE0F No pude asignarte el lead ${trigger.short_code}.\\n\\nPuede que otro asesor lo haya tomado primero, o que la subasta haya expirado. Cuando entre un nuevo lead te avisaremos.`\n  }\n}];"},"id":"fd34d5fe-6ba8-45ad-9bcb-520a3a4ade60","name":"Build 'Too Late' Message","type":"n8n-nodes-base.code","typeVersion":2,"position":[860,420]},{"parameters":{"method":"POST","url":"={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.EVOLUTION_API_KEY }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"{{ $json.number }}\",\n  \"text\": {{ JSON.stringify($json.text) }}\n}","options":{"timeout":10000}},"id":"066de598-a9e9-4a0e-8165-b19a2446f049","name":"Send 'Too Late' via Evolution","type":"n8n-nodes