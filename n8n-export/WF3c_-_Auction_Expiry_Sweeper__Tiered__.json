{
  "name": "WF3c - Tiered Escalation Sweeper (Evolution)",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.result, (r.result->>'state') AS state, (r.result->>'opportunity_id')::bigint AS opportunity_id FROM (SELECT public.v3_advance_routing_tier($1::bigint,$2,NOW()) AS result) r;",
        "options": {
          "queryReplacement": "={{ [$json.opportunity_id, $json.expected_tier || $json.routing_tier] }}"
        }
      },
      "id": "4907bdf7-6514-4c5e-b147-3cecbfee7398",
      "name": "Advance Expired Tiers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "route-guard",
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "guard_delivery_requested",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "guard_pending"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "route-unassigned",
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "assigned",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "unassigned"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unexpected_state"
        }
      },
      "id": "a1a2a3a4-0003-4000-8000-000000000003",
      "name": "Route Transition",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const state = String($json.state || 'missing');\nconst opportunityId = $json.opportunity_id == null ? 'missing' : String($json.opportunity_id);\nif (!['guard_delivery_pending', 'unassigned_alerted'].includes(state)) {\n  throw new Error(`unexpected_routing_transition_state state=${state} opportunity_id=${opportunityId}`);\n}\nreturn [{ json: $json }];"
      },
      "id": "a1a2a3a4-0014-4000-8000-000000000014",
      "name": "Reject Unexpected Transition State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        520
      ],
      "notes": "Fails loudly on an unknown SQL transition state so WF21 records the workflow error instead of silently dropping it."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.claim_pending_guard_deliveries(1);",
        "options": {}
      },
      "id": "a1a2a3a4-0004-4000-8000-000000000004",
      "name": "Claim Pending Guard Deliveries",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json:a})=>({json:{attempt_id:a.attempt_id,opportunity_id:a.opportunity_id,routing_tier:a.routing_tier,recipient_number:a.target_number,target_agent_id:a.target_agent_id,lease_token:a.lease_token}}));"
      },
      "id": "a1a2a3a4-0005-4000-8000-000000000005",
      "name": "Shape Guard Delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        180
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "Bo2YbbUpmBzRbhDa",
          "mode": "id"
        },
        "options": {}
      },
      "id": "a1a2a3a4-0006-4000-8000-000000000006",
      "name": "Call Directed Guard Offer",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1340,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.record_unassigned_alert($1::bigint, $2);",
        "options": {
          "queryReplacement": "={{ [$json.opportunity_id, 'wf3c:unassigned:' + $json.opportunity_id] }}"
        }
      },
      "id": "a1a2a3a4-0009-4000-8000-000000000009",
      "name": "Record Retryable Unassigned Alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        420
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\n  SELECT * FROM public.claim_unassigned_alerts(100, NOW(), INTERVAL '2 minutes')\n)\nSELECT claimed.*,\n       (SELECT a.whatsapp_number FROM public.agents a WHERE a.agent_id = 'agent_manager') AS manager_phone,\n       COALESCE(c.lead_name, 'Sin nombre') AS lead_name,\n       COALESCE(c.lead_phone, o.e164_phone, 'N/D') AS lead_phone\nFROM claimed\nJOIN public.lead_routing_opportunities o USING (opportunity_id)\nLEFT JOIN public.conversations c ON c.conversation_id = o.conversation_id;",
        "options": {}
      },
      "id": "a1a2a3a4-0008-4000-8000-000000000008",
      "name": "Claim Unassigned Alert Lease",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        520
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WA_CLOUD_API_BASE_URL + '/' + $env.WA_API_VERSION + '/' + $env.WA_PHONE_NUMBER_ID + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WA_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.manager_phone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"alerta_routing_v3\",\n    \"language\": { \"code\": \"es_MX\" },\n    \"components\": [{\n      \"type\": \"body\",\n      \"parameters\": [\n        { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.alert_kind || $json.reason || 'sin_responsable')) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.opportunity_id || 'No disponible')) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.property_id || 'No disponible')) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.state || 'unassigned_alerted')) }} },\n        { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.required_action || 'Revisar asignacion y cierre EasyBroker')) }} }\n      ]\n    }]\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1a2a3a4-0007-4000-8000-000000000007",
      "name": "WhatsApp Sandy Unassigned Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.complete_unassigned_alert_notification($1::bigint, $2::uuid, $3, $4);",
        "options": {
          "queryReplacement": "={{ [$('Claim Unassigned Alert Lease').item.json.opportunity_id, $('Claim Unassigned Alert Lease').item.json.lease_token, 'whatsapp', $json.messages?.[0]?.id || ''] }}"
        }
      },
      "id": "a1a2a3a4-0011-4000-8000-000000000011",
      "name": "Acknowledge Unassigned Alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
        380
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres - Supabase"
        }
      }
    },
    {
      "parameters": {},
      "id": "wf3c-sandy-alert-ack",
      "name": "V3 Sandy Assignment Durable",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1340,
        620
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "wf3c-execute-trigger",
      "name": "When Called by WF23",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -80,
        120
      ],
      "notes": "Scheduler removed; WF23 invokes this typed sub-workflow."
    }
  ],
