{"updatedAt":"2026-08-20T21:04:21.551Z","createdAt":"2026-08-13T17:04:29.329Z","id":"Z89IQDw1fgWlqXEW","name":"WF22 - Delivery Status","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"whatsapp-delivery-status","responseMode":"onReceived","options":{"rawBody":true}},"id":"wf22-status-webhook","name":"WA Status Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[240,300],"webhookId":"7b8fe64a-961c-4bf0-82bc-801eafa69911"},{"parameters":{"jsCode":"const crypto=require('crypto');\nconst item=$input.first(); const headers=item.json.headers||{}; const signature=String(headers['x-hub-signature-256']||headers['X-Hub-Signature-256']||'');\nconst encoded=item.binary?.data?.data; const secret=$env.WA_WEBHOOK_SECRET;\nif(typeof encoded!=='string'||!secret||!signature.startsWith('sha256=')) throw new Error('invalid webhook signature');\nconst raw=Buffer.from(encoded,'base64'); const expected='sha256='+crypto.createHmac('sha256',secret).update(raw).digest('hex'); const a=Buffer.from(signature),b=Buffer.from(expected);\nif(a.length!==b.length||!crypto.timingSafeEqual(a,b)) throw new Error('invalid webhook signature');\nreturn [{json:{body:JSON.parse(raw.toString('utf8'))}}];"},"id":"wf22-verify-signature","name":"Verify Meta Signature","type":"n8n-nodes-base.code","typeVersion":2,"position":[460,300]},{"parameters":{"jsCode":"const body=$input.first().json.body; const value=body.entry?.[0]?.changes?.[0]?.value||{}; return [{json:{kind:value.statuses?.length?'status':value.messages?.length?'message':'ignore',body}}];"},"id":"wf22-dispatch-meta","name":"Dispatch Meta Payload","type":"n8n-nodes-base.code","typeVersion":2,"position":[650,300]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict"},"conditions":[{"id":"wf22-kind-status","leftValue":"={{ $json.kind }}","rightValue":"status","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"r