      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SET LOCAL statement_timeout = '8s'; WITH i24 AS (\n  SELECT max(completed_at) AS last_ok\n  FROM scrape_logs\n  WHERE status='ok' AND (metadata->>'source'='inmuebles24' OR metadata->>'source' IS NULL)\n),\neb AS (\n  SELECT max(completed_at) AS last_ok\n  FROM scrape_logs\n  WHERE status='ok' AND metadata->>'source'='easybroker'\n),\nerrs AS (\n  SELECT count(*) AS n\n  FROM scrape_logs\n  WHERE status IN ('error','auth_error') AND completed_at > now() - interval '1 hour'\n)\nSELECT\n  i24.last_ok AS i24_last_ok,\n  EXTRACT(EPOCH FROM (now() - i24.last_ok))/60 AS i24_minutes_since,\n  eb.last_ok AS eb_last_ok,\n  EXTRACT(EPOCH FROM (now() - eb.last_ok))/60 AS eb_minutes_since,\n  errs.n AS recent_error_count,\n  ((now() AT TIME ZONE 'America/Mexico_City')::time BETWEEN time '08:45' AND time '20:45') AS i24_active_window\nFROM i24, eb, errs;",
          "options": {
            "connectionTimeout": 8
          }
        },
        "id": "9a1b0c1e-1111-4a1a-8000-000000000002",
        "name": "Check scraper health",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          224,
          16
        ],
        "credentials": {
          "postgres": {
            "id": "dEHKygi1neTNvPtH",
            "name": "Postgres account BYG project"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const row = $input.first().json;\nconst reasons = [];\nconst mins = [];\nconst i24Min = row.i24_last_ok ? Number(row.i24_minutes_since) : null;\nconst ebMin = row.eb_last_ok ? Number(row.eb_minutes_since) : null;\n// ponytail: EB intake stopped 2026-07-15 (client paused EasyBroker). Flip true to re-enable EB staleness alert.\nconst EB_ENABLED = false;\nconst errCount = Number(row.recent_error_count || 0);\n// i24 scraper only runs 08:00-20:00 MX; skip staleness outside window (+45m grace)\nconst i24Active = row.i24_active_window === true || row.i24_active_window === 'true';\n\nif (i24Active && (i24Min === null || i24Min > 45)) {\n  reasons.push(`Scraper i24: ${i24Min === null ? 'sin corridas ok registradas' : 'ultima ok hace ' + Math.round(i24Min) + ' min'} (umbral 45 min)`);\n  mins.push(i24Min || 0);\n}\nif (EB_ENABLED && (ebMin === null || ebMin > 45)) {\n  reasons.push(`Scraper EasyBroker: ${ebMin === null ? 'sin corridas ok registradas' : 'ultima ok hace ' + Math.round(ebMin) + ' min'} (umbral 45 min)`);\n  mins.push(ebMin || 0);\n}\nif (errCount >= 3) {\n  reasons.push(`${errCount} corridas con error/auth_error en la ultima hora`);\n}\n\nconst alert = reasons.length > 0;\nconst worstMin = mins.length ? Math.max(...mins) : 0;\nconst subject = alert\n  ? `⚠️ BYG: scraper sin corrida ok hace ${Math.round(worstMin)} min`\n  : 'BYG watchdog: ok';\nconst body = reasons.map(r => `- ${r}`).join('<br>');\n\nreturn [{ json: { alert, subject, body, i24Min, ebMin, errCount, i24Active } }];"
        },
