# =============================================================
# Inmobiliaria24 — Environment Variables
# Copy to .env and fill in your values
# =============================================================

# --- Inmuebles24 credentials (required) ---
INMUEBLES24_EMAIL=your_email@example.com
INMUEBLES24_PASSWORD=your_password_here

# --- EasyBroker Buzón bot (src/easybroker) ---
# UI login (SEPARATE from EASYBROKER_API_KEY). The bot logs into the EB Buzón to
# set leads to "Atendida" + add the assignment note (the API can't do either).
# EASYBROKER_EMAIL=your_eb_login@example.com
# EASYBROKER_PASSWORD=your_eb_password
# EB_MARK_ATTENDED=1        # gate: bot is a no-op unless set to 1
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=     # service-role key (poll + mark conversations)
# NOTE: EB's WAF returns 403 to headless browsers — run headful, or under xvfb
# on a headless host (Pi): xvfb-run -a python -m easybroker

# --- Reporte semanal (src/reporte_semanal) — email gerencial Lunes 8am ---
# Usa SUPABASE_URL + SUPABASE_SERVICE_KEY (arriba) para leer weekly_lead_report().
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=app_password_de_16_digitos   # Gmail: App Password (no la normal)
# REPORT_FROM=tucorreo@gmail.com
# REPORT_TO=sandy@ejemplo.com,marusa@ejemplo.com   # separados por coma

# --- State database ---
# STATE_DB_PATH=data/state.db

# --- CRM adapter ---
# CRM_ADAPTER=webhook  # webhook | hubspot
# WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-id
# CRM_API_KEY=           # HubSpot API key (when using hubspot adapter)

# --- WhatsApp Business API ---
# WA_API_KEY=             # Meta / BSP access token
# WA_PHONE_NUMBER_ID=     # WhatsApp phone number ID
# WA_WEBHOOK_VERIFY_TOKEN=inmobiliaria24_verify
# WA_WEBHOOK_SECRET=      # Webhook signature secret

# --- Bot configuration ---
# BOT_AGENT_PHONE=+521234567890
# BOT_AGENT_NAME=Carlos
# BOT_TIMEOUT_HOURS=24
# BOT_DB_PATH=data/conversations.db

# --- Monitoring (Telegram — errors only) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_ALERT_CHAT_ID=1234567890
