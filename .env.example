# =============================================================
# Inmobiliaria24 — Environment Variables
# Copy to .env and fill in your values. Placeholders only here.
# Values marked LIVE are what the Raspberry Pi runs today.
# =============================================================

# --- Dashboard password (required) ---
# Single shared password for dashboard access. Set in Vercel env vars.
DASHBOARD_PASSWORD=

# --- Session duration (optional, default 8h = 28800) ---
# SESSION_MAX_AGE_SECONDS=28800

# --- n8n API (LEGACY: the API key is dead; operate n8n via docker CLI) ---
# N8N_API_KEY=
# N8N_BASE_URL=https://n8n.srv856940.hstgr.cloud/api/v1

# --- Supabase (required for scraper, easybroker worker and dashboard) ---
# Project ref: wkaeutndwawkdhswisqe
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # dashboard
SUPABASE_SERVICE_KEY=               # scraper + easybroker worker (service-role)

# --- Inmuebles24 credentials (required) ---
INMUEBLES24_EMAIL=your_email@example.com
INMUEBLES24_PASSWORD=your_password_here

# --- Scraper intake webhook (src/inmobiliaria24) ---
WEBHOOK_URL=https://n8n.srv856940.hstgr.cloud/webhook/scraper-leads
I24_WEBHOOK_TOKEN=                  # shared secret with n8n headerAuth; never log it
# WEBHOOK_HEALTH_URL=http://localhost:8000/health   # monitor liveness probe

# --- Lead Routing V3 (LIVE) ---
LEAD_ROUTING_ACCOUNT_KEY=your_account_key   # must equal EASYBROKER_ACCOUNT_KEY

# --- Inmuebles24 portal status change ---
MARK_CONTACTED=1                    # legacy gate name, still honoured by the scraper

# --- EasyBroker Buzon worker (src/easybroker) — LIVE ---
# UI login (SEPARATE from EASYBROKER_API_KEY). The worker logs into the EB Buzon to
# set the exact request to "Atendida" + add the RESPONSABLE note (the API can't do either).
EASYBROKER_EMAIL=your_eb_login@example.com
EASYBROKER_PASSWORD=your_eb_password
EASYBROKER_API_KEY=                 # account API key; never log or commit
EASYBROKER_ACCOUNT_KEY=your_account_key   # must equal LEAD_ROUTING_ACCOUNT_KEY
EASYBROKER_V3_INBOX=1               # durable request-level ingest + exact-request effects
EASYBROKER_CREATE_REQUESTS=1        # idempotent contact-request creation (POST)
EB_MARK_ATTENDED=1                  # gate: the worker is a no-op unless set to 1
# NOTE: EB's WAF returns 403 to headless browsers — run headful, or under xvfb
# on a headless host (Pi): xvfb-run -a python -m easybroker

# --- Reporte semanal (src/reporte_semanal) — email gerencial Lunes 8am ---
# Usa SUPABASE_URL + SUPABASE_SERVICE_KEY (arriba) para leer weekly_lead_report().
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=app_password_de_16_digitos   # Gmail: App Password (no la normal)
# REPORT_FROM=tucorreo@gmail.com
# REPORT_TO=sandy@ejemplo.com,marusa@ejemplo.com   # separados por coma

# --- State database ---
# STATE_DB_PATH=data/state.db

# --- Monitoring (Telegram — errors only) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_ALERT_CHAT_ID=1234567890

# =============================================================
# LEGACY — not used by Lead Routing V3. Kept for reference only.
# =============================================================

# --- CRM adapter (legacy: the HubSpot path is unused) ---
# CRM_ADAPTER=webhook  # webhook | hubspot
# CRM_API_KEY=         # HubSpot API key (when using hubspot adapter)

# --- WhatsApp Business API (legacy: sends now happen inside n8n) ---
# WA_API_KEY=             # Meta / BSP access token
# WA_PHONE_NUMBER_ID=     # WhatsApp phone number ID
# WA_WEBHOOK_VERIFY_TOKEN=inmobiliaria24_verify
# WA_WEBHOOK_SECRET=      # Webhook signature secret
# WA_API_VERSION=v22.0

# --- Qualification bot (legacy: the night AI bot is off) ---
# BOT_AGENT_PHONE=+521234567890
# BOT_AGENT_NAME=Carlos
# BOT_TIMEOUT_HOURS=24
# BOT_DB_PATH=data/conversations.db
