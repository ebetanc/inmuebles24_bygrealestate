%%{init: {'theme': 'dark', 'themeVariables': { 'primaryColor': '#1a1a2e', 'primaryTextColor': '#e0e0e0', 'primaryBorderColor': '#6366f1', 'lineColor': '#818cf8', 'secondaryColor': '#16213e', 'tertiaryColor': '#0f3460'}}}%%

flowchart TB
    subgraph TRIGGER["⏰ SCHEDULE TRIGGER"]
        direction LR
        CRON["Cron Schedule\n3x Daily: 8AM · 2PM · 8PM\nMexico City Time UTC-6"]
    end

    subgraph SCRAPE["🔥 FIRECRAWL SCRAPING ENGINE"]
        direction TB
        FC_PAGE1["HTTP Request → Firecrawl\nPOST /v1/scrape\nPage 1"]
        FC_PAGE2["HTTP Request → Firecrawl\nPOST /v1/scrape\nPage 2"]
        FC_PAGE3["HTTP Request → Firecrawl\nPOST /v1/scrape\nPage 3"]
        MERGE_PAGES["Merge Node\nCombine all pages"]
        FC_PAGE1 --> MERGE_PAGES
        FC_PAGE2 --> MERGE_PAGES
        FC_PAGE3 --> MERGE_PAGES
    end

    subgraph PARSE["🤖 AI PARSING + EXTRACTION"]
        direction TB
        AI_EXTRACT["Code Node: Parse Markdown\nExtract structured listings"]
        AI_VALIDATE["Code Node: Validate & Hash\nNormalize data + unique ID"]
        AI_EXTRACT --> AI_VALIDATE
    end

    subgraph DEDUP["🔍 DEDUPLICATION ENGINE"]
        direction TB
        FETCH_EXISTING["Supabase: Get All\nFetch existing listing hashes"]
        COMPARE["Code: Compare & Filter\nKeep only NEW entries"]
        CHECK_NEW["IF: New Listings?\nCount > 0 → YES\nCount = 0 → NO"]
        FETCH_EXISTING --> COMPARE
        COMPARE --> CHECK_NEW
    end

    subgraph STORE["💾 SUPABASE STORAGE"]
        direction TB
        INSERT_NEW["Supabase: Create Rows\nInsert new listings"]
        LOG_RUN["Supabase: Log Run\nRecord scrape metadata"]
    end

    subgraph NOTIFY["📢 NOTIFICATIONS"]
        direction TB
        FORMAT_MSG["Code: Format Message\nHuman-readable summary"]
        SEND_TELEGRAM["Telegram Bot API\nSend alert"]
        SEND_EMAIL["Email Node\nOptional backup"]
        FORMAT_MSG --> SEND_TELEGRAM
        FORMAT_MSG --> SEND_EMAIL
    end

    subgraph NOACTION["✅ NO NEW LISTINGS"]
        LOG_NOCHANGE["Log: No Changes Found"]
    end

    CRON --> FC_PAGE1
    CRON --> FC_PAGE2
    CRON --> FC_PAGE3
    MERGE_PAGES --> AI_EXTRACT
    AI_VALIDATE --> FETCH_EXISTING
    CHECK_NEW -->|"YES"| INSERT_NEW
    CHECK_NEW -->|"NO"| LOG_NOCHANGE
    INSERT_NEW --> LOG_RUN
    LOG_RUN --> FORMAT_MSG
