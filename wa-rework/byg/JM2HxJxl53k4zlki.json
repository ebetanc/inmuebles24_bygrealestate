    {
      "parameters": {
        "jsCode": "const trigger = $('When Called by WF1').first().json;\nreturn [{\n  json: {\n    number: trigger.agent_phone,\n    text: `\\u26A0\\uFE0F No pude asignarte el lead ${trigger.short_code}.\\n\\nPuede que otro asesor lo haya tomado primero, o que la subasta haya expirado. Cuando entre un nuevo lead te avisaremos.`\n  }\n}];"
      },
