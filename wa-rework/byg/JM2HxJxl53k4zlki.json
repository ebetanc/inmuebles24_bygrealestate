      "id": "85cb99da-9e47-45f0-96d1-3c34d8286a33",
      "name": "Did This Agent Win?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversations\nSET assigned_agent_id=$1, mode='ai', assigned_at=NOW(), claimed_via='tomo_auction'\nWHERE conversation_id=$2::uuid\nRETURNING conversation_id, lead_phone, lead_name, current_property;",
        "options": {
          "queryReplacement": "={{ [$('When Called by WF1').item.json.agent_id, $json.conversation_id] }}"
        }
      },
      "id": "03d4ff26-bb45-4baa-96d9-0031c56c877e",
      "name": "Assign Conversation to Winner",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        860,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "dEHKygi1neTNvPtH",
          "name": "Postgres account BYG project"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Called by WF1').first().json;\nconst claim   = $('Atomic Claim (WHERE status=open)').first().json;\n\nconst winner = {\n  purpose: 'winner_confirmation',\n  number: trigger.agent_phone,\n  text: [\n    `\\u2705 Asignado! Lead: ${claim.lead_name || 'Sin nombre'}`,\n    `\\u{1F4F1} Telefono del lead: ${claim.lead_phone}`,\n    `\\u{1F3E0} Propiedad: ${claim.property_id}`,\n    ``,\n    `El asistente AI ya esta atendiendo sus preguntas. Te contactaremos si requiere tu intervencion (visita, negociacion, etc.).`\n  ].join('\\n')\n};\n\nconst leadGreeting = {\n  purpose: 'lead_greeting',\n  number: claim.lead_phone,\n  text: [\n    `Hola${claim.lead_name ? ' ' + claim.lead_name.split(' ')[0] : ''}! \\u{1F44B}`,\n    ``,\n    `Soy el asistente de la agencia. Estoy a tus ordenes para contarte sobre la propiedad. Que te gustaria saber? (precio, ubicacion, recamaras, amenidades, etc.)`,\n    ``,\n    `Hi${claim.lead_name ? ' ' + claim.lead_name.split(' ')[0] : ''}! I'm the agency assistant. I'm here to help you learn about this property. What would you like to know?`\n  ].join('\\n')\n};\n\nconst losers = (claim.notified_agents || [])\n  .filter(id => id !== trigger.agent_id)\n  .map(agent_id => ({\n    purpose: 'loser_notification',\n    agent_id,\n    text: `Este lead ya fue tomado por otro asesor. Suerte con el proximo! \\u{1F4AA}`\n  }));\n\nreturn [winner, leadGreeting, ...losers].map(m => ({ json: m }));"
      },
