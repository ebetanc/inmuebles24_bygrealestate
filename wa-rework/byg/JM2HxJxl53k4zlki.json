    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.eb_contact_id, ag.name AS agent_name, au.short_code\nFROM conversations c\nLEFT JOIN agents ag ON ag.agent_id = c.assigned_agent_id\nLEFT JOIN auctions au ON au.conversation_id = c.conversation_id\nWHERE c.conversation_id = $1::uuid AND c.eb_contact_id IS NOT NULL\nORDER BY au.created_at DESC LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.conversation_id] }}"
        }
      },
