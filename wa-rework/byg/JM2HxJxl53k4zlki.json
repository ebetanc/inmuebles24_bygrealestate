        "parameters": {
          "jsCode": "const meta = $('Get EB Note Data').first().json;\nconst existing = ($json && $json.private_description) || '';\nconst d = new Date().toLocaleString('es-MX', {timeZone:'America/Mexico_City', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'});\nconst line = d + ' - Asignado a ' + (meta.agent_name || 'agente') + ' via subasta (TOMO-' + (meta.short_code || '?') + '). [BYG bot]';\nconst updated = existing ? (existing + '\n' + line) : line;\nreturn [{ json: { eb_contact_id: meta.eb_contact_id, private_description: updated } }];"
