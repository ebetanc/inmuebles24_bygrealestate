      "name": "When Called by WF1",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "notes": "Input from WF1 when an agent sends TOMO-XXXX:\n{\n  agent_id: 'agent_yolanda',\n  agent_name: 'Yolanda',\n  agent_phone: '5215500000001',\n  short_code: 'AB12',\n  raw_message: 'TOMO-AB12',\n  messageId: '3EB0A0...'\n}"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- ATOMIC CLAIM: WHERE status='open' ensures first-reply-wins.\nWITH claim AS (\n  UPDATE auctions\n  SET status='claimed', winner_agent_id=$1, claimed_at=NOW()\n  WHERE short_code=$2 AND status='open' AND expires_at > NOW()\n  RETURNING auction_id, conversation_id, property_id, winner_agent_id, notified_agents\n)\nSELECT c.*, conv.lead_phone, conv.lead_name, pc.payload AS property_payload\nFROM claim c\nJOIN conversations conv ON conv.conversation_id = c.conversation_id\nLEFT JOIN properties_cache pc ON pc.property_id = c.property_id;",
        "options": {
          "queryReplacement": "={{ [$json.agent_id, $json.short_code] }}"
        }
      },
      "id": "86c01b28-9da5-4402-aeff-5ae13cf77363",
      "name": "Atomic Claim (WHERE status=open)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        420,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "dEHKygi1neTNvPtH",
          "name": "Postgres account BYG project"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "60c87d88-e8b4-4580-ba9a-c190d6ae6ee6",
              "leftValue": "={{ $json.auction_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
