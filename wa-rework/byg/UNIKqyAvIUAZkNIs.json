      },
      "id": "38f75920-a753-410b-a9b3-c2f04daefb9a",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH expired AS (\n  UPDATE auctions\n  SET status = 'expired'\n  WHERE status = 'open' AND expires_at <= NOW()\n  RETURNING auction_id, conversation_id, property_id, short_code\n)\nSELECT e.*, conv.lead_phone, conv.lead_name, m.manager_phone\nFROM expired e\nJOIN conversations conv ON conv.conversation_id = e.conversation_id\nCROSS JOIN (SELECT whatsapp_number AS manager_phone FROM agents WHERE agent_id = 'agent_manager') m;",
        "options": {}
      },
      "id": "4907bdf7-6514-4c5e-b147-3cecbfee7398",
      "name": "Expire Unclaimed Auctions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "dEHKygi1neTNvPtH",
          "name": "Postgres account BYG project"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "5be14f2d-6c1b-4965-9e61-402136262cfc",
              "leftValue": "={{ $json.auction_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c9629494-520c-4b4d-a8e4-fc40170a7e98",
      "name": "Any Expired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://graph.facebook.com/\" + $env.WA_API_VERSION + \"/\" + $env.WA_PHONE_NUMBER_ID + \"/messages\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WA_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.manager_phone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"lead_escalacion_manager\",\n    \"language\": { \"code\": \"es_MX\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.property_id || 'Propiedad')) }} },\n          { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.lead_name || 'Sin nombre')) }} },\n          { \"type\": \"text\", \"text\": {{ JSON.stringify(String($json.lead_phone || 'N/D')) }} }\n        ]\n      }\n    ]\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "bc828cbe-0205-481f-81d8-b1b75cdbc20e",
      "name": "Escalate to Manager via Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        200
      ],
      "continueOnFail": true
    }
  ],
