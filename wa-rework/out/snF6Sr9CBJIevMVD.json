    {
      "parameters": {
        "jsCode": "// Forward lead message to assigned agent via Evolution.\n// In human mode, the bot acts as a relay.\nconst data = $input.first().json;\n\nconst forwardBody = [\n  `Mensaje de ${data.pushName || 'Lead'} (${data.phone}):`,\n  ``,\n  data.text\n].join('\\n');\n\nreturn [{\n  json: {\n    number: data.assigned_agent_phone,\n    text: forwardBody,\n    conversation_id: data.conversation_id,\n    phone: data.phone\n  }\n}];"
      },
