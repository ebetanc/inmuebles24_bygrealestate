    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Dedup: try to insert the message. If msg_external_id already exists, skip.\n-- Also classify the sender in one round-trip.\nWITH dedup AS (\n  INSERT INTO messages (conversation_id, direction, sender_type, body, msg_external_id, metadata)\n  VALUES (NULL, 'inbound', 'lead', $1, $2, $3::jsonb)\n  ON CONFLICT (msg_external_id) DO NOTHING\n  RETURNING message_id\n),\nclassification AS (\n  SELECT * FROM classify_sender($4)\n)\nSELECT\n  (SELECT message_id FROM dedup) AS new_message_id,\n  c.*\nFROM classification c;",
        "options": {
          "queryReplacement": "={{ [$json.text, $json.messageId, JSON.stringify({ phone: $json.phone, pushName: $json.pushName, timestamp: $json.timestamp }), $json.phone] }}"
        }
      },
      "id": "fe60518a-2419-4e35-9133-283023544ab3",
      "name": "Dedup + Classify Sender",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        592,
        208
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "dEHKygi1neTNvPtH",
          "name": "Postgres account BYG project"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Determine routing based on dedup + classification results.\n// Input: the parsed message from 'Parse Evolution Payload' + DB classification.\n\nconst parsed = $('Parse Evolution Payload').first().json;\nconst db = $input.first().json;\n\n// If message was already processed (dedup), ignore\nif (!db.new_message_id && db.new_message_id !== 0) {\n  return [{ json: { route: 'ignore', reason: 'duplicate_message' } }];\n}\n\nconst phone = parsed.phone;\nconst text = parsed.text;\nconst pushName = parsed.pushName;\nconst messageId = parsed.messageId;\n\n// Check if sender is an agent\nif (db.is_agent) {\n  // Check if message is a TOMO claim\n  const tomoMatch = text.match(/^TOMO-([A-Z0-9]{4})$/i);\n  if (tomoMatch) {\n    return [{\n      json: {\n        route: 'agent_claim',\n        agent_id: db.agent_id,\n        agent_name: db.agent_name,\n        agent_phone: phone,\n        short_code: tomoMatch[1].toUpperCase(),\n        raw_message: text,\n        messageId\n      }\n    }];\n  }\n  // Agent sent a non-TOMO message -> follow-up reply (WF15 decides relevance)\n  return [{ json: { route: 'agent_followup_reply', agent_id: db.agent_id, agent_name: db.agent_name, agent_phone: phone, text, messageId } }];\n}\n\n// Not an agent - check conversation status\nif (!db.conversation_id) {\n  // New lead - no conversation exists\n  return [{\n    json: {\n      route: 'new_lead',\n      phone,\n      pushName,\n      text,\n      messageId\n    }\n  }];\n}\n\n// Existing conversation - route by mode\nconst mode = db.conv_mode;\nif (mode === 'ai') {\n  return [{\n    json: {\n      route: 'ai_conversation',\n      conversation_id: db.conversation_id,\n      phone,\n      pushName,\n      text,\n      messageId,\n      current_property: db.current_property,\n      assigned_agent_id: db.assigned_agent_id\n    }\n  }];\n}\n\nif (mode === 'human') {\n  return [{\n    json: {\n      route: 'human_forward',\n      conversation_id: db.conversation_id,\n      phone,\n      pushName,\n      text,\n      messageId,\n      assigned_agent_id: db.assigned_agent_id,\n      assigned_agent_phone: db.assigned_agent_phone\n    }\n  }];\n}\n\nif (mode === 'pending_assignment') {\n  return [{\n    json: {\n      route: 'pending',\n      conversation_id: db.conversation_id,\n      phone,\n      pushName,\n      text,\n      messageId\n    }\n  }];\n}\n\n// Fallback\nreturn [{ json: { route: 'ignore', reason: 'unknown_mode' } }];"
      },
