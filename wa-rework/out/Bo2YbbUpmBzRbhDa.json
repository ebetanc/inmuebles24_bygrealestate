 "name": "WF13 - Directed Owner Notify (Cloud API)",
 "description": null,
 "active": true,
 "isArchived": false,
 "nodes": [
  {
   "parameters": {
    "inputSource": "passthrough"
   },
   "id": "d1d2d3d4-0001-4000-8000-000000000001",
   "name": "When Called by WF10",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "typeVersion": 1,
   "position": [
    200,
    300
   ],
   "notes": "NIVEL owner. Input from WF10 after WF12 resolved an owner:\n{\n  conversation_id: UUID,\n  lead_phone, lead_name,\n  property_id: listing_id | EB code,\n  property_title, property_price,\n  owner_agent_id, owner_name, owner_number\n}\nCreates a 2-min auction scoped to the owner and DMs the owner a claim\ncode. Owner replies TOMO-XXXX -> WF1 -> WF3b atomic claim (same table).\nIf unclaimed in 2 min, WF3c escalates owner -> guard auction."
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "-- Create a 2-minute auction scoped to the owner agent, and mark the\n-- conversation as being in the 'owner' tier.\nWITH new_auction AS (\n  INSERT INTO auctions (conversation_id, property_id, short_code, expires_at, notified_agents)\n  VALUES ($1::uuid, $2, generate_tomo_code(), NOW() + INTERVAL '2 minutes', ARRAY[$3]::text[])\n  RETURNING auction_id, short_code, expires_at\n),\nupd AS (\n  UPDATE conversations\n  SET owner_agent_id = $3, routing_tier = 'owner', tier_notified_at = NOW()\n  WHERE conversation_id = $1::uuid\n  RETURNING conversation_id\n)\nSELECT a.auction_id, a.short_code, a.expires_at FROM new_auction a;",
    "options": {
     "queryReplacement": "={{ $json.conversation_id }},={{ $json.property_id }},={{ $json.owner_agent_id }}"
    }
   },
   "id": "d1d2d3d4-0002-4000-8000-000000000002",
   "name": "Create Owner Auction + Set Tier",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    440,
    300
   ],
   "credentials": {
    "postgres": {
     "id": "dEHKygi1neTNvPtH",
     "name": "Postgres account BYG project"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Build owner claim DM params for the Cloud-API template (lead_subasta_notify).\nconst t = $('When Called by WF10').first().json;\nconst a = $input.first().json;\nconst title = String(t.property_title || 'tu propiedad');\nconst price = String(t.property_price || 'Precio por confirmar');\nconst name  = String(t.lead_name || 'Sin nombre');\nconst code  = 'TOMO-' + a.short_code;\nreturn [{ json: {\n  number: t.owner_number,\n  auction_id: a.auction_id,\n  short_code: a.short_code,\n  conversation_id: t.conversation_id,\n  agent_id: t.owner_agent_id,\n  t_propiedad: title,\n  t_precio: price,\n  t_nombre: name,\n  t_codigo: code,\n  t_minutos: '2',\n  text: 'Lead directo (owner): ' + title + ' | ' + price + ' | ' + name + ' | ' + code + ' (2 min)'\n}}];"
   },
   "id": "d1d2d3d4-0003-4000-8000-000000000003",
   "name": "Build Owner Message",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    680,
    300
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ \"https://graph.facebook.com/\" + $env.WA_API_VERSION + \"/\" + $env.WA_PHONE_NUMBER_ID + \"/messages\" }}",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $env.WA_ACCESS_TOKEN }}"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.number }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"lead_subasta_notify\",\n    \"language\": { \"code\": \"es_MX\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": {{ JSON.stringify($json.t_propiedad) }} },\n          { \"type\": \"text\", \"text\": {{ JSON.stringify($json.t_precio) }} },\n          { \"type\": \"text\", \"text\": {{ JSON.stringify($json.t_nombre) }} },\n          { \"type\": \"text\", \"text\": {{ JSON.stringify($json.t_codigo) }} },\n          { \"type\": \"text\", \"text\": {{ JSON.stringify($json.t_minutos) }} }\n        ]\n      }\n    ]\n  }\n}",
    "options": {
     "timeout": 15000
    }
   },
   "id": "d1d2d3d4-0004-4000-8000-000000000004",
   "name": "Send to Owner (Cloud API)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    920,
    300
   ],
   "continueOnFail": true
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "INSERT INTO messages (conversation_id, direction, sender_type, recipient_phone, body, metadata)\nVALUES ($1::uuid, 'outbound', 'system', $2, $3, $4::jsonb);",
    "options": {
     "queryReplacement": "={{ [$json.conversation_id, $json.number, $json.text, JSON.stringify({ purpose: 'owner_notify', auction_id: $json.auction_id, agent_id: $json.agent_id })] }}"
    }
   },
   "id": "d1d2d3d4-0005-4000-8000-000000000005",
   "name": "Log Owner Message",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1160,
    300
   ],
   "credentials": {
    "postgres": {
     "id": "dEHKygi1neTNvPtH",
     "name": "Postgres account BYG project"
    }
   },
   "continueOnFail": true
  }
 ],
