#!/usr/bin/env bash
# rotate-proxy-ip: bump the DataImpulse sticky sessid baked into
# gost-proxy.service's ExecStart, restart the relay, print the new egress IP.
#
# ponytail: sessid counter lives directly in the unit file (no separate state
# file) — the unit IS the state. Wraps byg99 -> byg01.
set -euo pipefail

UNIT=/etc/systemd/system/gost-proxy.service
TS=$(date +%Y%m%d%H%M%S)

if [[ $EUID -ne 0 ]]; then
    echo "rotate-proxy-ip: must run as root" >&2
    exit 1
fi

if [[ ! -f "$UNIT" ]]; then
    echo "rotate-proxy-ip: unit file not found: $UNIT" >&2
    exit 1
fi

cp -p "$UNIT" "${UNIT}.bak.${TS}"

current=$(grep -oP 'sessid\.byg\K[0-9]+' "$UNIT" | head -n1)
if [[ -z "$current" ]]; then
    echo "rotate-proxy-ip: could not find sessid.bygNN in $UNIT" >&2
    exit 1
fi

# Force base-10 (avoid bash treating a leading-zero string like 08/09 as octal).
next=$((10#$current + 1))
if (( next > 99 )); then
    next=1
fi

current_padded=$(printf '%02d' "$((10#$current))")
next_padded=$(printf '%02d' "$next")

sed -i "s/sessid\.byg${current_padded}/sessid.byg${next_padded}/" "$UNIT"

echo "sessid: byg${current_padded} -> byg${next_padded}"

systemctl daemon-reload
systemctl restart gost-proxy
sleep 3

ip=$(curl -s -x http://127.0.0.1:18080 -m 20 https://api.ipify.org || echo "unknown")
echo "ip: ${ip}"
