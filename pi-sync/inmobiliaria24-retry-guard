#!/usr/bin/env bash
# inmobiliaria24-retry-guard: single guarded retry after inmobiliaria24.service
# fails (wired via OnFailure=). Waits 180s then restarts the scraper once —
# but skips entirely if a retry already ran in the last 20 minutes, so a
# string of failures can never loop forever (the 15-min timer covers the
# next slot regardless).
#
# ponytail: lock file lives in /run (tmpfs) — resets on reboot, which is fine,
# a reboot is already a fresh start.
set -euo pipefail

LOCK=/run/inmobiliaria24-retry.lock
NOW=$(date +%s)

if [[ -f "$LOCK" ]]; then
    last=$(cat "$LOCK" 2>/dev/null || echo 0)
    elapsed=$(( NOW - last ))
    if (( elapsed < 1200 )); then
        echo "inmobiliaria24-retry: last retry ${elapsed}s ago (<20min) — skipping, next timer run covers it"
        exit 0
    fi
fi

echo "$NOW" > "$LOCK"
echo "inmobiliaria24-retry: waiting 180s before retry"
sleep 180
echo "inmobiliaria24-retry: starting inmobiliaria24.service"
systemctl start inmobiliaria24.service
